#version 460
#extension GL_EXT_buffer_reference : require
layout(local_size_x=64) in;
layout(buffer_reference, std430, buffer_reference_align=16) readonly buffer Source { uint words[]; };
layout(buffer_reference, std430, buffer_reference_align=16) writeonly buffer Destination { uint words[]; };
layout(push_constant, std430) uniform Parameters { Source source; Destination destination; } parameters;
void main() {
    uint i=gl_GlobalInvocationID.x;
    if(i<256) parameters.destination.words[i]=parameters.source.words[i];
}
