#version 460
#extension GL_EXT_buffer_reference : require
layout(local_size_x=64) in;
layout(buffer_reference, std430, buffer_reference_align=16) readonly buffer Source { uint words[]; };
layout(buffer_reference, std430, buffer_reference_align=16) writeonly buffer Destination { uint words[]; };
layout(buffer_reference, std430, buffer_reference_align=16) readonly buffer Root { Source pages[]; };
layout(set=0,binding=0,std430) readonly buffer StorageCopy { uint words[]; } storageCopy;
layout(set=0,binding=1,std140) uniform UniformCopy { uvec4 words[256]; } uniformCopy;
layout(push_constant, std430) uniform Parameters { Root root; Destination destination; uint page; uint checkDescriptors; } parameters;
void main() {
    uint i=gl_GlobalInvocationID.x;
    if(i<1024) {
        uint value=parameters.root.pages[parameters.page].words[i];
        bool mismatch=parameters.checkDescriptors!=0 &&
            (value!=storageCopy.words[i] || value!=uniformCopy.words[i/4][i%4]);
        parameters.destination.words[i]=mismatch?~value:value;
    }
}
