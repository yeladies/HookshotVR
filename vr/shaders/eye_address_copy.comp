#version 460
#extension GL_EXT_buffer_reference : require
layout(local_size_x=64) in;
layout(buffer_reference, std430, buffer_reference_align=16) readonly buffer Source { uint words[]; };
layout(buffer_reference, std430, buffer_reference_align=16) writeonly buffer Destination { uint words[]; };
layout(buffer_reference, std430, buffer_reference_align=16) readonly buffer Root { Source pages[]; };
layout(push_constant, std430) uniform Parameters { Root root; Destination destination; uint page; } parameters;
void main() {
    uint i=gl_GlobalInvocationID.x;
    if(i<1024) parameters.destination.words[i]=parameters.root.pages[parameters.page].words[i];
}
