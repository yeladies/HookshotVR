#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x=8,local_size_y=8) in;
layout(buffer_reference,std430,buffer_reference_align=16) readonly buffer Source {uint words[];};
layout(buffer_reference,std430,buffer_reference_align=16) buffer Output {uint words[];};
layout(buffer_reference,std430,buffer_reference_align=16) buffer Counters {uint words[];};
layout(buffer_reference,std430,buffer_reference_align=16) readonly buffer Parameters {
    vec4 row0;vec4 row1;vec4 row2;vec4 tangents;vec4 projection;vec4 optical;uvec4 dimensions;uvec4 settings;
};
layout(push_constant,std430) uniform Dispatch {Source source;Output destination;Parameters camera;Counters counters;} p;
void finish(uint index,uint color,uint category){p.destination.words[index]=color;if(uint64_t(p.counters)!=0ul)atomicAdd(p.counters.words[category],1u);}
vec2 project_source(vec3 value){vec2 ndc=p.camera.projection.xy*value.xy/(-value.z)-p.camera.optical.xy;return vec2((ndc.x+1)*.5,(1-ndc.y)*.5);}
bool pixel_at(vec2 uv,out uvec2 pixel){if(any(isnan(uv))||any(isinf(uv))||any(lessThan(uv,vec2(0)))||any(greaterThanEqual(uv,vec2(1))))return false;pixel=uvec2(uv*vec2(p.camera.dimensions.xy));return true;}
bool depth_at(uvec2 pixel,out float z){
    uint index=pixel.y*p.camera.dimensions.x+pixel.x;
    float d=uintBitsToFloat(p.source.words[p.camera.dimensions.x*p.camera.dimensions.y+index]);
    if(isnan(d)||isinf(d)||d<0||d>1)return false;
    if(d>=.999999){z=-p.camera.optical.z;return true;}
    float denominator=2*d-1+p.camera.projection.z;if(abs(denominator)<1e-12)return false;
    z=-p.camera.projection.w/denominator;return !isnan(z)&&!isinf(z)&&z<0&&z>=-p.camera.optical.z;
}
float channel(uint bits,uint mantissa){uint exponent=bits>>mantissa;uint fraction=bits&((1u<<mantissa)-1u);if(exponent==31u)return 0;return exponent==0u?float(fraction)*exp2(float(-14-int(mantissa))):(1+float(fraction)/float(1u<<mantissa))*exp2(float(int(exponent)-15));}
vec3 rgb_at(uvec2 pixel){
    uint bits=p.source.words[pixel.y*p.camera.dimensions.x+pixel.x];
    vec3 rgb=p.camera.settings.x==123u?vec3(bits&511u,(bits>>9)&511u,(bits>>18)&511u)*exp2(float(int(bits>>27)-24)):
        vec3(channel(bits&2047u,6u),channel((bits>>11)&2047u,6u),channel(bits>>22,5u));
    return rgb;
}
uint pack_color(vec3 rgb){uvec3 value=uvec3(clamp(rgb,vec3(0),vec3(1))*255+.5);return value.x|(value.y<<8)|(value.z<<16)|0xff000000u;}
uint color_at(uvec2 pixel,vec2 uv,float surface_z){
    if(p.camera.settings.z==0u)return pack_color(rgb_at(pixel));
    // Interpolate in linear source color, never across a depth discontinuity.
    // This improves magnified texels without smearing foreground into background.
    vec2 coordinate=uv*vec2(p.camera.dimensions.xy)-.5;ivec2 base=ivec2(floor(coordinate));vec2 fraction=fract(coordinate);
    vec3 color=vec3(0);float total=0;
    for(int y=0;y<2;++y)for(int x=0;x<2;++x){uvec2 sample_pixel=uvec2(clamp(base+ivec2(x,y),ivec2(0),ivec2(p.camera.dimensions.xy)-1));float z;
        float weight=(x==0?1-fraction.x:fraction.x)*(y==0?1-fraction.y:fraction.y);
        if(weight>0&&depth_at(sample_pixel,z)&&abs(z-surface_z)<=max(.0001,abs(surface_z)*.01)){color+=weight*rgb_at(sample_pixel);total+=weight;}}
    return pack_color(total>0?color/total:rgb_at(pixel));
}
// Optional bounded background extrapolation for inverse-warp disocclusions.
// Only repairs failed surface correspondence, never invalid depth or coverage.
// It samples real farther-depth texels; hidden geometry remains an approximation.
bool repair_background(uvec2 center,vec3 ray,vec3 origin,out uint color){
    int radius=int(p.camera.settings.w);if(radius==0)return false;float front_z,back_z=0;if(!depth_at(center,front_z))return false;
    float best_distance=1e30;uvec2 chosen=center;bool found=false;
    const ivec2 directions[4]=ivec2[4](ivec2(1,0),ivec2(-1,0),ivec2(0,1),ivec2(0,-1));
    for(int distance=1;distance<=radius;++distance)for(int axis=0;axis<4;++axis){ivec2 candidate=ivec2(center)+directions[axis]*distance;
        if(any(lessThan(candidate,ivec2(0)))||any(greaterThanEqual(candidate,ivec2(p.camera.dimensions.xy))))continue;float z;if(!depth_at(uvec2(candidate),z))continue;front_z=max(front_z,z);
        float t=(z-origin.z)/ray.z;vec3 point=origin+ray*t;uvec2 checked;vec2 uv=project_source(point);if(t<=0||point.z>=0||!pixel_at(uv,checked))continue;
        float error=length(uv*vec2(p.camera.dimensions.xy)-(vec2(candidate)+.5));if(error>float(radius)+.75)continue;
        if(!found||z<back_z-max(.0001,abs(back_z)*.01)||(abs(z-back_z)<=max(.0001,abs(back_z)*.01)&&error<best_distance)){back_z=z;best_distance=error;chosen=uvec2(candidate);found=true;}}
    if(!found||back_z>=front_z-max(.0001,abs(front_z)*.01))return false;color=pack_color(rgb_at(chosen));return true;
}
void main(){
    uvec2 pixel=gl_GlobalInvocationID.xy;if(any(greaterThanEqual(pixel,p.camera.dimensions.zw)))return;
    uint index=pixel.y*p.camera.dimensions.z+pixel.x;vec2 fraction=(vec2(pixel)+.5)/vec2(p.camera.dimensions.zw);
    vec3 eye_ray=vec3(mix(p.camera.tangents.x,p.camera.tangents.y,fraction.x),mix(p.camera.tangents.z,p.camera.tangents.w,fraction.y),-1);
    vec3 ray=vec3(dot(p.camera.row0.xyz,eye_ray),dot(p.camera.row1.xyz,eye_ray),dot(p.camera.row2.xyz,eye_ray));
    vec3 origin=vec3(p.camera.row0.w,p.camera.row1.w,p.camera.row2.w);uvec2 source_pixel;float z;
    if(ray.z>=-.00001){finish(index,0xff000000u,1u);return;}
    vec2 seed=project_source(ray);if(any(isnan(seed))||any(isinf(seed))){finish(index,0xff000000u,1u);return;}
    // Clamp only the initial depth seed. Every final intersection must still
    // project inside the source: this does not stretch edge colors outward.
    source_pixel=uvec2(clamp(seed,vec2(0),vec2(1)-.5/vec2(p.camera.dimensions.xy))*vec2(p.camera.dimensions.xy));
    if(!depth_at(source_pixel,z)){finish(index,0xff000000u,2u);return;}
    float t=(z-origin.z)/ray.z;
    for(uint iteration=0u;iteration<p.camera.settings.y;++iteration){
        vec3 point=origin+ray*t;
        if(t<=0||point.z>=0||!pixel_at(project_source(point),source_pixel)){finish(index,0xff000000u,1u);return;}
        if(!depth_at(source_pixel,z)){finish(index,0xff000000u,2u);return;}
        t=(z-origin.z)/ray.z;
    }
    vec3 point=origin+ray*t;
    if(t<=0||point.z>=0||!pixel_at(project_source(point),source_pixel)){finish(index,0xff000000u,1u);return;}
    if(!depth_at(source_pixel,z)){finish(index,0xff000000u,2u);return;}
    vec2 ndc=vec2(2*(float(source_pixel.x)+.5)/p.camera.dimensions.x-1,1-2*(float(source_pixel.y)+.5)/p.camera.dimensions.y);
    vec3 surface=vec3(-z*(ndc+p.camera.optical.xy)/p.camera.projection.xy,z)-origin;
    vec3 eye=p.camera.row0.xyz*surface.x+p.camera.row1.xyz*surface.y+p.camera.row2.xyz*surface.z;
    // Check the final ray/depth agreement in SOURCE pixel units. A sampled
    // source texel has a finite footprint: measuring this quantization in
    // target pixels spuriously rejects flat surfaces when resolution/aspect
    // changes (for example a 1152x648 source feeding 1024x1024 eyes).
    float final_t=(z-origin.z)/ray.z;vec3 final_point=origin+ray*final_t;
    vec2 final_uv=project_source(final_point);uvec2 checked_pixel;
    if(final_t<=0||final_point.z>=0||!pixel_at(final_uv,checked_pixel)){finish(index,0xff000000u,1u);return;}
    vec2 source_error=final_uv*vec2(p.camera.dimensions.xy)-(vec2(source_pixel)+.5);
    if(eye.z>=0||any(isnan(eye))||any(isinf(eye))||any(isnan(source_error))||any(isinf(source_error))){finish(index,0xff000000u,3u);return;}
    if(length(source_error)>p.camera.optical.w){uint repaired;finish(index,repair_background(source_pixel,ray,origin,repaired)?repaired:0xff000000u,3u);return;}
    finish(index,color_at(source_pixel,final_uv,z),0u);
}
