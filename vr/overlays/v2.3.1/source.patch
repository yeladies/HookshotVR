diff --git a/vr/depth_scene_mesh.py b/vr/depth_scene_mesh.py
new file mode 100644
index 0000000000000000000000000000000000000000..ca6559416744bd6699b9006aeb645c0e810c4419
--- /dev/null
+++ b/vr/depth_scene_mesh.py
@@ -0,0 +1,74 @@
+# SPDX-License-Identifier: GPL-3.0-or-later
+"""Build a PRIVATE frozen depth mesh for XR calibration; never a live stereo renderer."""
+import argparse,json,math,struct
+from pathlib import Path
+
+def unpack_channel(bits,mantissa):
+    fraction=bits&((1<<mantissa)-1);exponent=bits>>mantissa
+    if exponent==31:return 0.0
+    return math.ldexp(fraction,-14-mantissa) if exponent==0 else math.ldexp(1+fraction/(1<<mantissa),exponent-15)
+
+def reconstruct(x,y,depth,width,height,p):
+    if not math.isfinite(depth) or not 0<=depth<0.999999:return None
+    denominator=2*depth-1+p[10]
+    if abs(denominator)<1e-12:return None
+    z=-p[11]/denominator
+    if not math.isfinite(z) or z>=0:return None
+    return (-z*((2*(x+.5)/width-1)+p[2])/p[0],-z*((1-2*(y+.5)/height)+p[6])/p[5],z)
+
+def convert(source,destination,scale=1.,step=6,max_distance=80):
+    if not math.isfinite(scale) or not .0001<=scale<=10 or not 1<=step<=32:raise ValueError('Invalid scale or sampling step')
+    if Path(source).stat().st_size>16*1024*1024+132:raise ValueError("Capture exceeds byte budget")
+    data=Path(source).read_bytes()
+    if len(data)<132 or data[:8]!=b'HSVRD2\0\0':raise ValueError('Expected a version-two capture with explicit color view format')
+    width,height,view_format=struct.unpack_from('<III',data,8);p=struct.unpack_from('<16f',data,20);v=struct.unpack_from('<12f',data,84)
+    if view_format not in (122,123):raise ValueError('Unsupported captured color view')
+    if not 1<=width<=1920 or not 1<=height<=1080 or len(data)!=132+width*height*8:raise ValueError('Capture size/budget mismatch')
+    if not all(math.isfinite(x) for x in (*p,*v)) or p[0]<=0 or p[5]<=0 or abs(p[14]+1)>1e-5 or abs(p[15])>1e-5:raise ValueError('Unsupported source projection')
+    if any(abs(sum(v[4*r+k]*v[4*s+k] for k in range(3))-(r==s))>.003 for r in range(3) for s in range(3)):raise ValueError('Source view is not rigid')
+    yaw=math.atan2(v[8],v[10]);co,si=math.cos(yaw),math.sin(yaw)
+    xs=list(range(0,width,step));ys=list(range(0,height,step))
+    if xs[-1]!=width-1:xs.append(width-1)
+    if ys[-1]!=height-1:ys.append(height-1)
+    if (len(xs)-1)*(len(ys)-1)*6>1000000:raise ValueError("Sampling exceeds vertex budget; increase step")
+    points=[];depths=[]
+    for y in ys:
+        row=[]
+        for x in xs:
+            index=y*width+x;depth=struct.unpack_from('<f',data,132+width*height*4+index*4)[0];point=reconstruct(x,y,depth,width,height,p)
+            if point is None:row.append(None);continue
+            depths.append(-point[2]);world=[sum(v[4*r+k]*point[r] for r in range(3)) for k in range(3)]
+            position=((co*world[0]-si*world[2])*scale,world[1]*scale,(si*world[0]+co*world[2])*scale)
+            distance=math.sqrt(sum(c*c for c in position))
+            if distance>max_distance:row.append(None);continue
+            pixel=struct.unpack_from('<I',data,132+index*4)[0]
+            if view_format==123:
+                multiplier=math.ldexp(1.,(pixel>>27)-24);rgb=tuple(((pixel>>shift)&511)*multiplier for shift in (0,9,18))
+            else:rgb=(unpack_channel(pixel&2047,6),unpack_channel((pixel>>11)&2047,6),unpack_channel(pixel>>22,5))
+            # Gameplay upscale input is square-root encoded LDR (vk_temporal.h).
+            color=tuple(min(1.,max(0.,c))**2 for c in rgb)
+            row.append((*position,*color,distance))
+        points.append(row)
+    vertices=[];rejected=0
+    for y in range(len(ys)-1):
+        for x in range(len(xs)-1):
+            a,b,c,d=points[y][x],points[y][x+1],points[y+1][x],points[y+1][x+1]
+            for triangle in ((a,c,b),(b,c,d)):
+                if any(q is None for q in triangle):rejected+=1;continue
+                distances=[q[6] for q in triangle]
+                if max(distances)>min(distances)*1.15:rejected+=1;continue
+                for q in triangle:vertices.extend(q[:6])
+    count=len(vertices)//6
+    if not 3<=count<=1000000:raise ValueError('No bounded visible mesh; inspect capture and scale')
+    payload=struct.pack('<8sIf',b'HSVRM1\0\0',count,scale)+struct.pack('<'+'f'*len(vertices),*vertices)
+    Path(destination).write_bytes(payload)
+    depths.sort()
+    report={'vertices':count,'triangles':count//3,'rejected_triangles':rejected,'color_view_format':view_format,'source_width':width,'source_height':height,'metres_per_game_unit':scale,'source_depth_percentiles':{str(q):depths[min(len(depths)-1,int((len(depths)-1)*q))] for q in (.1,.5,.9)},'mesh_bytes':len(payload),'frozen_scene':True,'native_stereo_render':False,'game_derived_private_output':True}
+    Path(str(destination)+'.json').write_text(json.dumps(report,indent=2)+'\n');return report
+
+def main():
+    parser=argparse.ArgumentParser(description=__doc__);parser.add_argument('capture',type=Path);parser.add_argument('mesh',type=Path);parser.add_argument('--scale',type=float,default=1.);parser.add_argument('--step',type=int,default=6)
+    args=parser.parse_args()
+    try:print(json.dumps(convert(args.capture,args.mesh,args.scale,args.step),indent=2))
+    except (ValueError,OSError,struct.error) as error:parser.error(str(error))
+if __name__=='__main__':main()
diff --git a/vr/first_person_assets.py b/vr/first_person_assets.py
new file mode 100644
index 0000000000000000000000000000000000000000..64acbefde7291f0a55d9e32a045a30696a267f40
--- /dev/null
+++ b/vr/first_person_assets.py
@@ -0,0 +1,141 @@
+"""Read the user's local Link bind poses; never ship the generated profile.
+
+FRES skeleton layout reference (format facts; no library code copied):
+https://github.com/KillzXGaming/BfresLibrary/tree/master/BfresLibrary/Shared/Models/Skeleton
+Only little-endian FRES 10.4 with one validated skeleton is accepted.
+"""
+import argparse
+import hashlib
+import json
+import math
+import struct
+import sys
+from pathlib import Path
+
+
+def multiply(a, b):
+    return [sum(a[4*r+k]*b[4*k+c] for k in range(4)) for r in range(4) for c in range(4)]
+
+
+def local_matrix(scale, rotation, position, euler):
+    if not all(math.isfinite(v) for v in (*scale, *rotation, *position)):
+        raise ValueError('non-finite bone transform')
+    if euler:
+        x, y, z = rotation[:3]
+        cx, sx, cy, sy, cz, sz = math.cos(x), math.sin(x), math.cos(y), math.sin(y), math.cos(z), math.sin(z)
+        r = [cz*cy, cz*sy*sx-sz*cx, cz*sy*cx+sz*sx,
+             sz*cy, sz*sy*sx+cz*cx, sz*sy*cx-cz*sx,
+             -sy, cy*sx, cy*cx]
+    else:
+        norm = math.sqrt(sum(v*v for v in rotation))
+        if norm < 1e-12:
+            raise ValueError('zero bone quaternion')
+        x, y, z, w = (v/norm for v in rotation)
+        r = [1-2*(y*y+z*z), 2*(x*y-z*w), 2*(x*z+y*w),
+             2*(x*y+z*w), 1-2*(x*x+z*z), 2*(y*z-x*w),
+             2*(x*z-y*w), 2*(y*z+x*w), 1-2*(x*x+y*y)]
+    return [r[0]*scale[0],r[1]*scale[1],r[2]*scale[2],position[0],
+            r[3]*scale[0],r[4]*scale[1],r[5]*scale[2],position[1],
+            r[6]*scale[0],r[7]*scale[1],r[8]*scale[2],position[2],0,0,0,1]
+
+
+def bind_eye_profile(raw):
+    if len(raw) < 64 or raw[:4] != b'FRES' or raw[8:12] != bytes((0,4,10,0)) or raw[12:14] != b'\xff\xfe':
+        raise ValueError('unsupported FRES version or byte order')
+    def unpack(fmt, offset):
+        if offset < 0 or offset + struct.calcsize(fmt) > len(raw):
+            raise ValueError('truncated skeleton')
+        return struct.unpack_from(fmt, raw, offset)
+    def skeleton(offset):
+        array, = unpack('<Q', offset+16)
+        count, = unpack('<H', offset+56)
+        if not 1 <= count <= 4096 or array < 64 or array+88*count > len(raw):
+            raise ValueError('invalid bone array')
+        bones = []
+        names = {}
+        for k in range(count):
+            at = array+88*k
+            name, = unpack('<Q',at)
+            length, = unpack('<H',name)
+            if not 1 <= length <= 256 or name+2+length >= len(raw) or raw[name+2+length] != 0:
+                raise ValueError('invalid bone name')
+            name = raw[name+2:name+2+length].decode('utf-8',errors='strict')
+            index, parent = unpack('<Hh',at+32)
+            if index != k or not -1 <= parent < count or name in names:
+                raise ValueError('invalid bone identity')
+            flags, = unpack('<I',at+44)
+            local = local_matrix(unpack('<3f',at+48),unpack('<4f',at+60),unpack('<3f',at+76),bool(flags & 0x1000))
+            bones.append((parent,local))
+            names[name] = k
+        if not all(name in names for name in ('Head','Eyeball_L','Eyeball_R')):
+            raise ValueError('missing head or eye bones')
+        world, pending = {}, set()
+        def resolve(k):
+            if k in world:
+                return world[k]
+            if k in pending:
+                raise ValueError('cyclic skeleton')
+            pending.add(k)
+            parent, local = bones[k]
+            world[k] = multiply(resolve(parent),local) if parent >= 0 else local
+            pending.remove(k)
+            return world[k]
+        # Validate every bone, including unused branches.
+        for k in range(count):
+            resolve(k)
+        for eye in ('Eyeball_L','Eyeball_R'):
+            parent = names[eye]
+            while parent >= 0 and parent != names['Head']:
+                parent = bones[parent][0]
+            if parent < 0:
+                raise ValueError('eyes do not descend from head')
+        left, right = world[names['Eyeball_L']], world[names['Eyeball_R']]
+        midpoint = [(left[4*k+3]+right[4*k+3])*.5 for k in range(3)]
+        if not all(math.isfinite(v) for v in midpoint) or midpoint[1] <= 0:
+            raise ValueError('invalid bind eye position')
+        return {'eye_height':midpoint[1], 'forward_offset':midpoint[2],
+                'lateral_offset':midpoint[0], 'bone_count':count,
+                'model_sha256':hashlib.sha256(raw).hexdigest()}
+    matches = []
+    offset = raw.find(b'FSKL')
+    while offset >= 0:
+        try:
+            matches.append(skeleton(offset))
+        except (ValueError,UnicodeError,struct.error,RecursionError):
+            pass
+        offset = raw.find(b'FSKL',offset+4)
+    if len(matches) != 1:
+        raise ValueError('expected one unambiguous validated player skeleton')
+    return matches[0]
+
+
+def generate(romfs, units_per_metre):
+    if not math.isfinite(units_per_metre) or not .001 <= units_per_metre <= 1000:
+        raise ValueError('invalid explicit world scale')
+    import zstandard as zs
+    sys.path.insert(0,str(Path(__file__).resolve().parents[1]/'nx2'))
+    import shader_census as census
+    dictionaries = census.dictionaries(romfs,zs)
+    models = {}
+    for age in ('Child','Adult'):
+        source = Path(romfs)/'Model'/f'Player_{age}.Player_{age}.bfres.zs'
+        raw = census.unpack(source.read_bytes(),dictionaries,zs)
+        models[age.lower()] = bind_eye_profile(raw)
+    return {'schema':1,'private_game_derived':True,'units_per_metre':units_per_metre,
+            'physical_scale_calibrated':False,'anchor':'player_root_plus_bind_eye_no_animation_bob','models':models}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--romfs',required=True,type=Path)
+    parser.add_argument('--out',required=True,type=Path)
+    parser.add_argument('--units-per-metre',required=True,type=float)
+    args = parser.parse_args()
+    result = generate(args.romfs,args.units_per_metre)
+    args.out.parent.mkdir(parents=True,exist_ok=True)
+    args.out.write_text(json.dumps(result,indent=2)+'\n',encoding='utf-8')
+    print('Generated private eye profile; do not publish it. Physical scale still needs headset calibration.')
+
+
+if __name__ == '__main__':
+    main()
diff --git a/vr/first_person_head_mask.py b/vr/first_person_head_mask.py
new file mode 100644
index 0000000000000000000000000000000000000000..e61f4c578fe7b06c26b7ab68098a9d72fa19f1f4
--- /dev/null
+++ b/vr/first_person_head_mask.py
@@ -0,0 +1,214 @@
+"""Create a private first-person model overlay from the user's own game.
+
+Only triangle index bytes are changed. Sizes, counts, bindings and vertices stay
+unchanged. This diagnostic mask also removes head shadows/cutscene geometry;
+a future render-only mask should replace it before normal release use.
+Format facts: KillzXGaming/BfresLibrary Switch skeleton/shape/vertex readers.
+No game data or generated models may be published.
+"""
+import argparse
+import hashlib
+import importlib.util
+import json
+import math
+import struct
+import sys
+from pathlib import Path
+
+
+def hide_head(raw, threshold=.25):
+    if not math.isfinite(threshold) or not 0 < threshold <= 1:
+        raise ValueError('invalid head weight threshold')
+    # The bind-pose reader validates every bone and rejects ambiguous skeletons.
+    spec = importlib.util.spec_from_file_location('first_person_assets',Path(__file__).with_name('first_person_assets.py'))
+    assets = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(assets)
+    assets.bind_eye_profile(raw)
+    def read(fmt, at):
+        if at < 0 or at+struct.calcsize('<'+fmt) > len(raw):
+            raise ValueError('resource outside file')
+        return struct.unpack_from('<'+fmt,raw,at)
+    def text(at):
+        n, = read('H',at)
+        if not 1 <= n <= 256 or at+2+n >= len(raw) or raw[at+2+n] != 0:
+            raise ValueError('invalid resource string')
+        return raw[at+2:at+2+n].decode('utf-8',errors='strict')
+    # External-string references (bit 1) may coexist with the inline bone and
+    # shape names validated below. Separate GPU data and string-holder files
+    # require a different reader and remain rejected.
+    if raw[238] & ~2:
+        raise ValueError('external GPU/string-holder sections are unsupported')
+    skeleton = raw.index(b'FSKL')
+    bones, mapping_at = read('QQ',skeleton+16)
+    count, smooth, rigid = read('HHH',skeleton+56)
+    mapping = read('H'*(smooth+rigid),mapping_at)
+    if not mapping or any(k >= count for k in mapping):
+        raise ValueError('invalid skin matrix mapping')
+    parents = [read('h',bones+88*k+34)[0] for k in range(count)]
+    heads = [k for k in range(count) if text(read('Q',bones+88*k)[0]) == 'Head']
+    if len(heads) != 1:
+        raise ValueError('ambiguous head')
+    head_bones = set()
+    for k in range(count):
+        parent = k
+        while parent >= 0:
+            if parent == heads[0]:
+                head_bones.add(k)
+                break
+            parent = parents[parent]
+    info, = read('Q',176)
+    buffer_base, = read('Q',info+8)
+    if not 0 < buffer_base < len(raw):
+        raise ValueError('invalid GPU buffer section')
+    index_formats = {0x302:'B',0x309:'BB',0x30b:'BBBB',0x30a:'H',0x312:'HH',0x315:'HHHH'}
+    weight_formats = {0x102:'B',0x109:'BB',0x10b:'BBBB'}
+    result = bytearray(raw)
+    changed = set()
+    reports = []
+    shape = raw.find(b'FSHP')
+    while shape >= 0:
+        name_at, vertex, meshes = read('QQQ',shape+8)
+        name = text(name_at)
+        skin = raw[shape+90]
+        mesh_count = raw[shape+91]
+        if not 1 <= skin <= 8 or not 1 <= mesh_count <= 16 or raw[vertex:vertex+4] != b'FVTX':
+            raise ValueError('unsupported player shape')
+        attributes, = read('Q',vertex+8)
+        sizes, strides = read('QQ',vertex+48)
+        relative, = read('I',vertex+72)
+        num_attributes, num_buffers = raw[vertex+76:vertex+78]
+        vertices, = read('I',vertex+80)
+        alignment, = read('H',vertex+86)
+        if not 1 <= num_attributes <= 64 or not 1 <= num_buffers <= 8 or not 1 <= vertices <= 1000000 or not alignment or alignment & (alignment-1):
+            raise ValueError('invalid vertex layout')
+        streams = []
+        start = buffer_base+relative
+        for k in range(num_buffers):
+            start = (start+alignment-1)&~(alignment-1)
+            size, = read('I',sizes+16*k)
+            stride, = read('I',strides+16*k)
+            if stride <= 0 or start < buffer_base or start+size > len(raw) or size < vertices*stride:
+                raise ValueError('invalid vertex stream')
+            streams.append((start,size,stride))
+            start += size
+        attrs = {}
+        for k in range(num_attributes):
+            at = attributes+16*k
+            attr = text(read('Q',at)[0])
+            if attr in attrs:
+                raise ValueError('duplicate vertex attribute')
+            fmt, = struct.unpack_from('>H',raw,at+8)
+            offset, stream = read('HH',at+12)
+            if stream >= len(streams):
+                raise ValueError('invalid attribute stream')
+            attrs[attr] = (fmt,offset,stream)
+        def values(prefix, vertex_index, formats):
+            out = []
+            for k in range(2):
+                item = attrs.get(prefix+str(k))
+                if item is None:
+                    continue
+                fmt, offset, stream = item
+                layout = formats.get(fmt)
+                if layout is None:
+                    raise ValueError('unsupported skin attribute format')
+                start,size,stride = streams[stream]
+                width = struct.calcsize('<'+layout)
+                if offset+width > stride:
+                    raise ValueError('skin attribute crosses vertex stride')
+                out.extend(read(layout,start+vertex_index*stride+offset))
+            return out[:skin]
+        masked = []
+        for k in range(vertices):
+            ids = values('_i',k,index_formats)
+            weights = values('_w',k,weight_formats) if skin > 1 else [255]
+            if len(ids) != skin or len(weights) != skin or not 253 <= sum(weights) <= 257:
+                raise ValueError('invalid skin weights')
+            if any(index >= len(mapping) for index,weight in zip(ids,weights) if weight):
+                raise ValueError('skin index outside skeleton mapping')
+            masked.append(sum(weight for index,weight in zip(ids,weights) if weight and mapping[index] in head_bones) >= threshold*sum(weights))
+        removed = total = 0
+        for k in range(mesh_count):
+            at = meshes+56*k
+            relative, primitive, index_format, indices, first = read('IIIII',at+32)
+            size, = read('I',read('Q',at+24)[0])
+            width = {1:2,2:4}.get(index_format)
+            start = buffer_base+relative
+            if primitive != 3 or width is None or indices % 3 or size != indices*width or start < buffer_base or start+size > len(raw):
+                raise ValueError('unsupported triangle index buffer')
+            fmt = 'H' if width == 2 else 'I'
+            for triangle in range(indices//3):
+                pos = start+3*width*triangle
+                original = read(fmt*3,pos)
+                if any(index+first >= vertices for index in original):
+                    raise ValueError('triangle index outside vertex buffer')
+                total += 1
+                if any(masked[index+first] for index in original):
+                    # Repeated indices produce no surface in every LOD. Counts,
+                    # submesh ranges and the resource's uncompressed size stay valid.
+                    data = struct.pack('<'+fmt*3,original[0],original[0],original[0])
+                    for offset,value in enumerate(data):
+                        target = pos+offset
+                        if result[target] != value:
+                            result[target] = value
+                            changed.add(target)
+                    removed += 1
+        reports.append({'shape':name,'triangles':total,'removed':removed,'head_vertices':sum(masked)})
+        shape = raw.find(b'FSHP',shape+4)
+    if not reports or not changed:
+        raise ValueError('no head geometry was masked')
+    # No model headers, skeleton or vertex data may be changed.
+    return bytes(result), {'private_game_derived':True,'source_sha256':hashlib.sha256(raw).hexdigest(),
+        'output_sha256':hashlib.sha256(result).hexdigest(),'changed_index_bytes':len(changed),
+        'same_uncompressed_size':len(result)==len(raw),'threshold':threshold,'shapes':reports}
+
+
+def generate_overlay(romfs, output):
+    import zstandard as zs
+    sys.path.insert(0,str(Path(__file__).resolve().parents[1]/'nx2'))
+    import shader_census as census
+    if output.exists():
+        raise ValueError('head mask output must be a fresh directory')
+    dictionaries = census.dictionaries(romfs,zs)
+    pending = []
+    report = {'schema':1,'private_game_derived':True,'all_passes_including_shadows':True,'models':{}}
+    for age in ('Child','Adult'):
+        relative = Path('Model')/f'Player_{age}.Player_{age}.bfres.zs'
+        packed = (romfs/relative).read_bytes()
+        raw = census.unpack(packed,dictionaries,zs)
+        masked,details = hide_head(raw)
+        dictionary_id = zs.get_frame_parameters(packed).dict_id
+        dictionary = None
+        if dictionary_id:
+            for data in dictionaries:
+                candidate = zs.ZstdCompressionDict(data,dict_type=zs.DICT_TYPE_FULLDICT)
+                if candidate.dict_id() == dictionary_id:
+                    dictionary = candidate
+                    break
+            if dictionary is None:
+                raise ValueError('source compression dictionary not found')
+        compressor = zs.ZstdCompressor(level=8,dict_data=dictionary)
+        encoded = compressor.compress(masked)
+        if census.unpack(encoded,dictionaries,zs) != masked:
+            raise ValueError('overlay round trip failed')
+        pending.append((relative,encoded))
+        report['models'][age.lower()] = details
+    # All source layouts validated before creating any output file.
+    for relative,data in pending:
+        target = output/relative
+        target.parent.mkdir(parents=True,exist_ok=True)
+        target.write_bytes(data)
+    (output/'head-mask-private-report.json').write_text(json.dumps(report,indent=2)+'\n',encoding='utf-8')
+    return report
+
+
+def main():
+    parser=argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--romfs',required=True,type=Path)
+    parser.add_argument('--out',required=True,type=Path)
+    args=parser.parse_args()
+    generate_overlay(args.romfs,args.out)
+    print('Created private head-only geometry overlay. Do not publish generated models or reports.')
+
+
+if __name__=='__main__':main()
