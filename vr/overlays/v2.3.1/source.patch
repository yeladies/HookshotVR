+    check(plan.eyes[1].view.eye[0]-plan.eyes[0].view.eye[0]>0.0639&&horizontal(plan.eyes[0].world_to_clip)>horizontal(plan.eyes[1].world_to_clip),"IPD and composed stereo parallax");
