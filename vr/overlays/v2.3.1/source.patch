+                XrSwapchainImageReleaseInfo release{XR_TYPE_SWAPCHAIN_IMAGE_RELEASE_INFO};xr_check(xrReleaseSwapchainImage(eye.swapchain,&release),"xrReleaseSwapchainImage");
+                projection[i].pose=views[i].pose;projection[i].fov=views[i].fov;
+                projection[i].subImage={eye.swapchain,{{0,0},{static_cast<int32_t>(eye.width),static_cast<int32_t>(eye.height)}},0};
+            }
+            ++rendered;
+        }
+        XrFrameEndInfo end{XR_TYPE_FRAME_END_INFO};end.displayTime=state.predictedDisplayTime;end.environmentBlendMode=XR_ENVIRONMENT_BLEND_MODE_OPAQUE;
+        if(state.shouldRender && valid) {end.layerCount=1;end.layers=layers;}
+        xr_check(xrEndFrame(session,&end),"xrEndFrame");
+    }
+    void run(int seconds) {
+        const auto started=Clock::now();auto deadline=started+std::chrono::seconds(45);
+        bool began=false,visible_once=false,requested_exit=false;
+        while(!exiting) {
+            events();if(exiting) break;
+            const auto now=Clock::now();
+            if(running) began=true;
+            if(rendered && !visible_once) {visible_once=true;deadline=now+std::chrono::seconds(seconds);}
+            if(now>=deadline) {
+                if(!began) throw std::runtime_error("Session never reached READY");
+                if(!visible_once) std::cerr<<"Runtime did not make the scene visible within 45 seconds. No frames were forced while shouldRender was false.\n";
+                if(!requested_exit && running) {xr_check(xrRequestExitSession(session),"xrRequestExitSession");requested_exit=true;deadline=now+std::chrono::seconds(2);}
+                else break;
+            }
+            if(running) frame();else std::this_thread::sleep_for(std::chrono::milliseconds(10));
+        }
+    }
+    void report() const {
+        auto pose=[](const XrPosef& p) {
+            std::cout<<"{\"position_m\":["<<p.position.x<<','<<p.position.y<<','<<p.position.z<<"],\"orientation_xyzw\":["
+                     <<p.orientation.x<<','<<p.orientation.y<<','<<p.orientation.z<<','<<p.orientation.w<<"]}";
+        };
+        std::cout<<"{\n  \"depth_stream_updates\": "<<depth_scene.updates()<<",\n  \"session_created\": "<<(session?"true":"false")<<",\n  \"frames\": "<<frames
+                 <<",\n  \"stereo_frames_submitted\": "<<rendered<<",\n  \"valid_view_samples\": "<<view_samples
+                 <<",\n  \"valid_head_samples\": "<<head_samples<<",\n  \"left_hand_samples\": "<<hand_samples[0]
+                 <<",\n  \"right_hand_samples\": "<<hand_samples[1]
+                 <<",\n  \"head_position_range_m\": ["<<maximum.x-minimum.x<<','<<maximum.y-minimum.y<<','<<maximum.z-minimum.z<<"]"
+                 <<",\n  \"last_head_pose\": ";
+        if(head_samples) pose(last_head);else std::cout<<"null";
+        std::cout<<",\n  \"last_left_hand_pose\": ";if(hand_samples[0]) pose(last_hands[0]);else std::cout<<"null";
+        std::cout<<",\n  \"last_right_hand_pose\": ";if(hand_samples[1]) pose(last_hands[1]);else std::cout<<"null";
+        std::cout<<"\n}\n";
+        std::cerr<<"Runtime-selected GPU: "<<gpu<<'\n';
+    }
+    ~Scene() {
+        if(vk.device && vk.DeviceWaitIdle) vk.DeviceWaitIdle(vk.device);
+        for(auto& eye:eyes) {
+            for(auto f:eye.frames) if(f && vk.DestroyFramebuffer) vk.DestroyFramebuffer(vk.device,f,nullptr);
+            for(auto v:eye.views) if(v && vk.DestroyImageView) vk.DestroyImageView(vk.device,v,nullptr);
+            if(eye.swapchain) xrDestroySwapchain(eye.swapchain);
+        }
+        depth_scene.close();
+        for(auto s:hand_spaces) if(s) xrDestroySpace(s);
+        if(head) xrDestroySpace(head);
+        if(local) xrDestroySpace(local);
+        if(session) xrDestroySession(session);
+        if(action_set) xrDestroyActionSet(action_set);
+        if(vk.device) {
+            if(render_pass && vk.DestroyRenderPass) vk.DestroyRenderPass(vk.device,render_pass,nullptr);
+            if(fence && vk.DestroyFence) vk.DestroyFence(vk.device,fence,nullptr);
+            if(pool && vk.DestroyCommandPool) vk.DestroyCommandPool(vk.device,pool,nullptr);
+            if(vk.DestroyDevice) {vk.DestroyDevice(vk.device,nullptr);vk.device=VK_NULL_HANDLE;}
+        }
+        if(vk.instance && vk.destroy_instance) {vk.destroy_instance(vk.instance,nullptr);vk.instance=VK_NULL_HANDLE;}
+        if(instance) xrDestroyInstance(instance);
+    }
+};
+} // namespace
+int main(int argc,char** argv) {
+    if((argc==5||argc==7)&&std::string(argv[1])=="--stream-check"&&std::string(argv[3])=="--output"){
+        try{int seconds=0;if(argc==7){size_t used=0;if(std::string(argv[5])!="--seconds")throw std::runtime_error("stream check duration");seconds=std::stoi(argv[6],&used);if(used!=std::strlen(argv[6]))throw std::runtime_error("stream check duration");}if(seconds<0||seconds>30)throw std::runtime_error("stream check duration");return depth_scene_smoke(argv[2],argv[4],true,seconds);}catch(const std::exception& e){std::cerr<<e.what()<<'\n';return 2;}}
+    if(argc==5&&std::string(argv[1])=="--mesh-check"&&std::string(argv[3])=="--output"){try{return depth_scene_smoke(argv[2],argv[4]);}catch(const std::exception& e){std::cerr<<e.what()<<'\n';return 2;}}
+    int seconds=15;std::string mesh;bool live=false;
+    if(argc==5&&(std::string(argv[1])=="--mesh"||std::string(argv[1])=="--stream")&&std::string(argv[3])=="--seconds"){live=std::string(argv[1])=="--stream";mesh=argv[2];argv+=2;argc-=2;}
+    if(argc==3 && std::string(argv[1])=="--seconds") {
+        try {size_t used=0;seconds=std::stoi(argv[2],&used);if(used!=std::strlen(argv[2]) || seconds<1 || seconds>90) throw std::runtime_error("range");}
+        catch(...) {std::cerr<<"--seconds must be 1..90\n";return 2;}
+    } else if(argc!=1) {std::cerr<<"Usage: hookshot_vr_scene [--seconds 1..90]\n";return 2;}
+    try {
+        Scene scene;if(!mesh.empty()){if(live)scene.depth_scene.load_stream(mesh);else scene.depth_scene.load(mesh);std::cerr<<(live?"LIVE DEPTH RECONSTRUCTION: not native game stereo; vertices=":"FROZEN GAME DEPTH SCENE: calibration preview, not live native stereo; vertices=")<<scene.depth_scene.vertices()<<"\n";}scene.init();scene.run(seconds);scene.report();
+        return scene.rendered && scene.head_samples?0:3;
+    } catch(const std::exception& e) {std::cerr<<e.what()<<'\n';return 2;}
+}
diff --git a/vr/src/stereo_plan.h b/vr/src/stereo_plan.h
new file mode 100644
index 0000000000000000000000000000000000000000..608972cd22eede83e2f76f3a39196ac4e68eb215
--- /dev/null
+++ b/vr/src/stereo_plan.h
@@ -0,0 +1,55 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include "camera_math.h"
+#include "eye_matrices.h"
+#include <array>
+namespace hookshot::vr {
+struct GameCameraStamp { uint64_t camera_id=0,revision=0;int64_t present=0,received_ns=0; };
+struct EyeFrameInput {
+    uint64_t sequence=0,origin_generation=0;
+    int64_t predicted_display_time=0,observed_ns=0;
+    bool should_render=false;
+    XrView eyes[2]{{XR_TYPE_VIEW},{XR_TYPE_VIEW}};
+    XrSpaceLocationFlags flags[2]{};
+};
+struct StereoCalibration {
+    TrackingOrigin origin;
+    uint64_t camera_id=0,origin_generation=0;
+    double near_z=0,far_z=0;
+    ClipDepth clip=ClipDepth::MinusOneToOne;
+    DepthOrder depth=DepthOrder::Forward;
+    bool flip_y=false;
+};
+struct DiagnosticStereoPlan {
+    GameCameraStamp game;
+    uint64_t xr_sequence=0,origin_generation=0;
+    int64_t predicted_display_time=0;
+    std::array<EyeMatrices,2> eyes;
+};
+// Pure, unsubmitted plan. Close timestamps are not proof of a shared simulation/render tick.
+// A caller must supply an explicit calibration and receive-time stamps from the same host clock.
+inline bool build_stereo_plan(const GameCameraStamp& game,const EyeFrameInput& frame,
+                              const StereoCalibration& calibration,int64_t now_ns,DiagnosticStereoPlan& out) {
+    if(!game.camera_id||!game.revision||game.present<0||!frame.sequence||!frame.origin_generation||
+       !frame.should_render||frame.predicted_display_time<=0||
+       calibration.camera_id!=game.camera_id||calibration.origin_generation!=frame.origin_generation)return false;
+    for(auto at:{game.received_ns,frame.observed_ns})if(at<=0||now_ns<at||now_ns-at>100000000)return false;
+    if(std::abs(double(game.received_ns-frame.observed_ns))>50000000)return false;
+    DiagnosticStereoPlan candidate{};candidate.game=game;candidate.xr_sequence=frame.sequence;
+    candidate.origin_generation=frame.origin_generation;candidate.predicted_display_time=frame.predicted_display_time;
+    for(int eye=0;eye<2;++eye) {
+        const auto& input=frame.eyes[eye];auto& result=candidate.eyes[eye];
+        if(!tracked_camera_view(calibration.origin,input.pose,frame.flags[eye],result.view))return false;
+        const auto f=input.fov;
+        if(!eye_projection({f.angleLeft,f.angleRight,f.angleUp,f.angleDown},calibration.near_z,calibration.far_z,
+                           calibration.clip,calibration.depth,calibration.flip_y,result.projection))return false;
+        for(int row=0;row<4;++row)for(int col=0;col<4;++col) {
+            double value=0;
+            for(int k=0;k<4;++k)value+=result.projection[4*row+k]*(k==3?(col==3?1:0):result.view.rows[k][col]);
+            if(!std::isfinite(value))return false;
+            result.world_to_clip[4*row+col]=value;
+        }
+    }
+    out=candidate;return true; // Neither eye becomes visible to the caller on a partial failure.
+}
+}
