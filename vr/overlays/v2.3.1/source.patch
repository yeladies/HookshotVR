+        const bool lean=sweep&&!std::strcmp(sweep,"Lean");
+        const bool wide_yaw=sweep&&!std::strcmp(sweep,"WideYaw"),wide_pitch=sweep&&!std::strcmp(sweep,"WidePitch");
