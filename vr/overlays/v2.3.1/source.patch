+    constexpr size_t width=160,height=32,frame=width*height*4;std::vector<unsigned char> images(6*frame);
+    auto rect=[&](unsigned slot,unsigned x,unsigned y){for(unsigned r=0;r<4;++r)for(unsigned c=0;c<8;++c)images[slot*frame+((y+r)*width+x+c)*4]=7;};
+    for(unsigned slot=1;slot<=3;++slot)rect(slot,70,8);
