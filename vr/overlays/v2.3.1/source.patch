+# SPDX-License-Identifier: GPL-3.0-or-later
+"""Summarize private native module/binding observations without exposing shader code."""
+import argparse
+import importlib.util
+import json
+from pathlib import Path
+import re
+
+spec = importlib.util.spec_from_file_location('uniform_reader', Path(__file__).with_name('audit_spirv_uniforms.py'))
+reader = importlib.util.module_from_spec(spec); spec.loader.exec_module(reader)
+
+
+def analyze_directory(directory):
+    root = Path(directory).resolve()
+    metadata = root / 'program-bindings.jsonl'
+    if metadata.stat().st_size > 4 * 1024 * 1024:
+        raise ValueError('Binding metadata exceeds its limit')
+    records = [json.loads(line) for line in metadata.read_text(encoding='utf-8-sig').splitlines() if line.strip()]
+    if not records or len(records) > 64:
+        raise ValueError('Expected one to 64 observed programs')
+    programs, queries = set(), {}
+    stage_regions = {}
+    observed_stages = set()
+    primary_bindings = missing = unresolved = static_queries = resolved = outside = 0
+    observed_bindings = missing_observed_modules = 0
+    candidate_bindings = eligible_scans = incomplete_scans = 0
+    candidate_reads = {"view":0,"projection":0,"vp":0}
+    for record in records:
+        program = record.get('program')
+        if record.get('schema') != 1 or type(program) is not int or not 0 < program < (1 << 64) or program in programs:
+            raise ValueError('Invalid or repeated program observation')
+        programs.add(program)
+        bindings = record.get('bindings')
+        if not isinstance(bindings, list) or len(bindings) > 128:
+            raise ValueError('Invalid bounded binding list')
+        for binding in bindings:
+            if not isinstance(binding.get('primary_camera_binding'), bool):
+                raise ValueError('Missing camera-source provenance flag')
+            fields = ('nvn_stage', 'vk_stage', 'binding', 'array_element', 'bank', 'range_bytes')
+            if any(type(binding.get(field)) is not int or binding[field] < 0 for field in fields):
+                raise ValueError('Invalid binding integers')
+            observed_bindings += 1
+            observed_stages.add(binding['nvn_stage'])
+            digest = binding.get('module')
+            if digest is None:
+                missing_observed_modules += 1
+                if binding['primary_camera_binding']:
+                    primary_bindings += 1; missing += 1
+                continue
+            if not isinstance(digest, str) or not re.fullmatch('[0-9a-f]{16}', digest):
+                raise ValueError('Invalid module fingerprint')
+            path = root / (digest + '.spv')
+            if path.is_symlink() or path.resolve().parent != root:
+                raise ValueError('Module path escapes the private audit directory')
+            if not path.is_file():
+                missing_observed_modules += 1
+                if binding['primary_camera_binding']:
+                    primary_bindings += 1; missing += 1
+                continue
+            for flag in ('candidate_scan_eligible','candidate_scan_truncated'):
+                if flag in binding and type(binding[flag]) is not bool:
+                    raise ValueError('Invalid camera scan flag')
+            ambiguity = binding.get('ambiguous_candidate_offsets',0)
+            if type(ambiguity) is not int or not 0<=ambiguity<=4096:
+                raise ValueError('Invalid camera scan ambiguity count')
+            candidates = {}
+            for kind, size in (("view",48),("projection",64),("vp",64)):
+                values = binding.get('candidate_'+kind+'_offsets',[])
+                if not isinstance(values,list) or len(values)>64 or any(type(v) is not int or v<0 or v%16 or v+size>binding['range_bytes'] for v in values):
+                    raise ValueError('Invalid bounded camera candidate offsets')
+                if values and not binding.get('candidate_scan_eligible',False):
+                    raise ValueError('Candidate offsets require an eligible submitted scan')
+                candidates[kind]=(values,size)
+            eligible_scans += bool(binding.get('candidate_scan_eligible',False))
+            incomplete_scans += bool(binding.get('candidate_scan_truncated',False) or binding.get('ambiguous_candidate_offsets',0))
+            candidate = bool(candidates['view'][0] or candidates['vp'][0])
+            if candidate: candidate_bindings += 1
+            if not binding['primary_camera_binding'] and not candidate:
+                continue
+            if binding['primary_camera_binding']: primary_bindings += 1
+            key = (digest, binding['binding'], binding['array_element'], binding['range_bytes'])
+            if key not in queries:
+                try:
+                    result = reader.analyze(reader.read_module(path), binding['binding'], 0, binding['array_element'], binding['range_bytes'])
+                except (OSError, ValueError, IndexError, TypeError) as error:
+                    result = {'error': str(error), 'camera_regions_read': [], 'static_loads': 0, 'static_subset_resolved': False}
+                queries[key] = result
+            result = queries[key]
+            if binding['primary_camera_binding']:
+                stage_regions.setdefault(str(binding['nvn_stage']), set()).update(result['camera_regions_read'])
+            reads = result.get('static_read_word_offsets',[])
+            for kind,(offsets,size) in candidates.items():
+                if any(start<=word<start+size for start in offsets for word in reads): candidate_reads[kind]+=1
+    for result in queries.values():
+        if result.get('static_loads', 0): static_queries += 1
+        if result.get('static_subset_resolved'): resolved += 1
+        else: unresolved += 1
+        outside += result.get('outside_captured_camera_block', 0)
+    return {'schema': 1, 'observed_programs': len(programs), 'primary_camera_bindings': primary_bindings,
+            'eligible_candidate_scans': eligible_scans, 'ambiguous_or_truncated_candidate_scans': incomplete_scans,
+            'candidate_camera_bindings': candidate_bindings, 'candidate_bindings_with_static_reads': candidate_reads,
+            'candidate_camera_semantics_confirmed': False,
+            'observed_nvn_stages': sorted(observed_stages), 'observed_bindings': observed_bindings, 'missing_observed_modules': missing_observed_modules,
+            'unique_module_binding_queries': len(queries), 'queries_with_static_reads': static_queries,
+            'resolved_static_subsets': resolved, 'unresolved_queries': unresolved, 'missing_primary_modules': missing,
+            'read_words_outside_captured_block': outside,
+            'camera_regions_by_nvn_stage': {stage: sorted(regions) for stage, regions in sorted(stage_regions.items())},
+            'query_errors': sorted({result['error'] for result in queries.values() if 'error' in result}),
+            'safe_to_patch': False, 'complete_shader_semantic_proof': False,
+            'scope': 'Representative source-checked bindings and conservative static module reads only'}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('directory', type=Path)
+    args = parser.parse_args()
+    try:
+        result = analyze_directory(args.directory)
+    except (OSError, ValueError, IndexError, TypeError, KeyError) as error:
+        parser.exit(2, str(error) + '\n')
+    print(json.dumps(result, indent=2))
+
+
+if __name__ == '__main__': main()
diff --git a/vr/audit_spirv_uniforms.py b/vr/audit_spirv_uniforms.py
new file mode 100644
index 0000000000000000000000000000000000000000..eb522abbf6d6fa4e1d3faf4e271eead0de7dbefb
--- /dev/null
+++ b/vr/audit_spirv_uniforms.py
@@ -0,0 +1,191 @@
+# SPDX-License-Identifier: GPL-3.0-or-later
+"""Conservative static reads of one SPIR-V uniform binding; never modifies modules."""
+import argparse
+import json
+import struct
+from pathlib import Path
+
+# Verified against the installed Khronos unified1 grammar. Normative reference:
+# https://registry.khronos.org/SPIR-V/specs/unified1/SPIRV.html
+TYPE_INT, TYPE_FLOAT, TYPE_VECTOR, TYPE_MATRIX = 21, 22, 23, 24
+TYPE_ARRAY, TYPE_RUNTIME_ARRAY, TYPE_STRUCT, TYPE_POINTER = 28, 29, 30, 32
+CONSTANT, CONSTANT_NULL, VARIABLE, LOAD = 43, 46, 59, 61
+ACCESS_CHAIN, INBOUNDS_ACCESS_CHAIN, PTR_ACCESS_CHAIN, INBOUNDS_PTR_ACCESS_CHAIN = 65, 66, 67, 70
+DECORATE, MEMBER_DECORATE, COPY_OBJECT = 71, 72, 83
+UNIFORM, BLOCK, ARRAY_STRIDE, BINDING, DESCRIPTOR_SET, OFFSET = 2, 2, 6, 33, 34, 35
+
+
+def instructions(words):
+    if len(words) < 5 or words[0] != 0x07230203 or not 0 < words[3] <= (1 << 24):
+        raise ValueError('Invalid bounded SPIR-V header')
+    index = 5
+    while index < len(words):
+        size, opcode = words[index] >> 16, words[index] & 0xffff
+        if not size or index + size > len(words):
+            raise ValueError('Truncated or zero-length SPIR-V instruction')
+        yield opcode, words[index+1:index+size]
+        index += size
+
+
+def analyze(words, binding, descriptor_set=0, array_element=0, byte_limit=65536):
+    if min(binding, descriptor_set, array_element) < 0 or not 0 < byte_limit <= 65536:
+        raise ValueError('Invalid binding or uniform range')
+    ops = list(instructions(words))
+    types, constants, decorations, member_offsets = {}, {}, {}, {}
+    for opcode, args in ops:
+        if opcode in (TYPE_INT, TYPE_FLOAT, TYPE_VECTOR, TYPE_MATRIX, TYPE_ARRAY, TYPE_RUNTIME_ARRAY, TYPE_STRUCT, TYPE_POINTER):
+            if not args: raise ValueError('Missing type ID')
+            types[args[0]] = (opcode, args[1:])
+        elif opcode == CONSTANT and len(args) >= 3:
+            kind, data = types.get(args[0], (None, []))
+            if kind == TYPE_INT and data[0] in (32, 64):
+                value = args[2] | ((args[3] << 32) if data[0] == 64 and len(args) > 3 else 0)
+                if data[1] and value & (1 << (data[0]-1)): value -= 1 << data[0]
+                constants[args[1]] = value
+        elif opcode == CONSTANT_NULL and len(args) == 2:
+            if types.get(args[0], (None, []))[0] == TYPE_INT: constants[args[1]] = 0
+        elif opcode == DECORATE and len(args) >= 2:
+            decorations[(args[0], args[1])] = args[2] if len(args) > 2 else True
+        elif opcode == MEMBER_DECORATE and len(args) >= 4 and args[2] == OFFSET:
+            member_offsets[(args[0], args[1])] = args[3]
+
+    def size_of(type_id, seen=()):
+        if type_id in seen: return None
+        kind, data = types.get(type_id, (None, [])); seen = seen + (type_id,)
+        if kind in (TYPE_INT, TYPE_FLOAT): return data[0] // 8 if data and data[0] in (8, 16, 32, 64) else None
+        if kind == TYPE_VECTOR:
+            element = size_of(data[0], seen)
+            return None if element is None else element * data[1]
+        if kind == TYPE_ARRAY:
+            stride, length = decorations.get((type_id, ARRAY_STRIDE)), constants.get(data[1])
+            return stride * length if type(stride) is int and length is not None and 0 <= length <= 65536 else None
+        if kind == TYPE_STRUCT:
+            end = 0
+            for index, member in enumerate(data):
+                offset, size = member_offsets.get((type_id, index)), size_of(member, seen)
+                if offset is None or size is None: return None
+                end = max(end, offset + size)
+            return end
+        return None  # Matrix/member stride and runtime aggregates require explicit further support.
+
+    def pointee(pointer_type):
+        kind, data = types.get(pointer_type, (None, []))
+        return data[1] if kind == TYPE_POINTER and len(data) == 2 and data[0] == UNIFORM else None
+
+    pointer_results = {}
+    for opcode, args in ops:
+        if opcode in (43, 45, 46, 55, 57, 59, 65, 66, 67, 70, 83, 120, 124, 169, 245) and len(args) >= 2:
+            if types.get(args[0], (None, []))[0] == TYPE_POINTER:
+                pointer_results[args[1]] = args[0]
+    targets = set()
+    pointers = {}
+    for opcode, args in ops:
+        if opcode == VARIABLE and len(args) >= 3 and args[2] == UNIFORM:
+            pointers[args[1]] = (args[1], pointee(args[0]), 0, True)
+            if decorations.get((args[1], BINDING)) == binding and decorations.get((args[1], DESCRIPTOR_SET), 0) == descriptor_set:
+                targets.add(args[1])
+    static_loads, dynamic_loads, unknown_loads, outside_loads, unsupported_reads = 0, 0, 0, 0, 0
+    read_words = set()
+    for opcode, args in ops:
+        if opcode in (ACCESS_CHAIN, INBOUNDS_ACCESS_CHAIN) and len(args) >= 3:
+            if pointee(args[0]) is None:
+                pointers[args[1]] = (None, None, None, False)
+                continue
+            root, current, offset, eligible = pointers.get(args[2], (None, None, None, True))
+            indices = args[3:]
+            # An array of uniform Blocks is a descriptor array, not byte-strided data inside one buffer.
+            kind, data = types.get(current, (None, []))
+            if kind == TYPE_ARRAY and data and decorations.get((data[0], BLOCK)):
+                selected = constants.get(indices[0]) if indices else None
+                eligible = eligible and (selected == array_element or selected is None)
+                if selected is None: offset = None
+                current = data[0]; indices = indices[1:]
+            for index_id in indices:
+                index = constants.get(index_id)
+                kind, data = types.get(current, (None, []))
+                if index is None or index < 0 or offset is None:
+                    offset = None; break
+                if kind == TYPE_STRUCT:
+                    member_offset = member_offsets.get((current, index))
+                    if index >= len(data) or member_offset is None: offset = None; break
+                    offset += member_offset; current = data[index]
+                elif kind in (TYPE_ARRAY, TYPE_RUNTIME_ARRAY):
+                    stride = decorations.get((current, ARRAY_STRIDE))
+                    length = constants.get(data[1]) if kind == TYPE_ARRAY else None
+                    if type(stride) is not int or (length is not None and index >= length): offset = None; break
+                    offset += stride * index; current = data[0]
+                elif kind == TYPE_VECTOR:
+                    scalar = size_of(data[0])
+                    if scalar is None or index >= data[1]: offset = None; break
+                    offset += scalar * index; current = data[0]
+                else:
+                    offset = None; break
+            pointers[args[1]] = (root, current, offset, eligible)
+        elif opcode == COPY_OBJECT and len(args) >= 3 and pointee(args[0]) is not None:
+            pointers[args[1]] = pointers.get(args[2], (None, pointee(args[0]), None, True))
+        elif opcode in (PTR_ACCESS_CHAIN, INBOUNDS_PTR_ACCESS_CHAIN) and len(args) >= 3:
+            root, _, _, eligible = pointers.get(args[2], (None, None, None, True))
+            pointers[args[1]] = (root, pointee(args[0]), None, eligible)
+        elif opcode == LOAD and len(args) >= 3:
+            if args[2] not in pointer_results:
+                raise ValueError('Load references an unknown pointer ID')
+            if pointee(pointer_results[args[2]]) is None:
+                continue
+            root, _, offset, eligible = pointers.get(args[2], (None, None, None, True))
+            if not eligible: continue
+            if root is None:
+                # Only count unresolved Uniform pointers, not unrelated storage/image loads.
+                unknown_loads += 1
+                continue
+            if root not in targets: continue
+            size = size_of(args[0])
+            if offset is None or size is None:
+                dynamic_loads += 1; continue
+            if offset < 0 or size <= 0 or offset + size > byte_limit:
+                outside_loads += 1; continue
+            static_loads += 1
+            read_words.update(range(offset // 4 * 4, (offset + size + 3) // 4 * 4, 4))
+        elif opcode in (63, 64) and len(args) >= 2:  # OpCopyMemory[ Sized ]
+            root = pointers.get(args[1], (None, None, None, True))[0]
+            if root in targets: unsupported_reads += 1
+        elif len(args) >= 2 and opcode not in (VARIABLE, DECORATE, MEMBER_DECORATE) and pointee(args[0]) is not None:
+            # Phi/select/function pointer values remain unresolved rather than borrowing another binding.
+            pointers[args[1]] = (None, pointee(args[0]), None, True)
+    regions = {'view': (0, 0x30), 'view_projection': (0x30, 0x70), 'projection': (0x70, 0xb0),
+               'inverse_view_candidate': (0xb0, 0xe0), 'projection_like_0x1c0': (0x1c0, 0x200)}
+    return {'schema': 1, 'binding': binding, 'descriptor_set': descriptor_set, 'array_element': array_element,
+            'matching_uniform_variables': len(targets), 'static_loads': static_loads,
+            'dynamic_or_unsupported_target_loads': dynamic_loads, 'unknown_uniform_pointer_loads': unknown_loads,
+            'out_of_range_target_loads': outside_loads, 'unsupported_target_memory_operations': unsupported_reads,
+            'static_read_word_offsets': sorted(read_words),
+            'camera_regions_read': [name for name, (start, end) in regions.items() if any(start <= off < end for off in read_words)],
+            'outside_captured_camera_block': sum(off >= 0x230 for off in read_words),
+            'static_subset_resolved': bool(targets) and not (dynamic_loads or unknown_loads or outside_loads or unsupported_reads),
+            'safe_to_patch': False, 'scope': 'Conservative static load footprint, not complete shader semantic proof'}
+
+
+def read_module(path):
+    path = Path(path)
+    length = path.stat().st_size
+    if length > 8 * 1024 * 1024 or length % 4:
+        raise ValueError('Invalid bounded SPIR-V byte length')
+    data = path.read_bytes()
+    return list(struct.unpack('<' + 'I'*(len(data)//4), data))
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('module', type=Path)
+    parser.add_argument('--binding', type=int, required=True)
+    parser.add_argument('--set', type=int, default=0, dest='descriptor_set')
+    parser.add_argument('--array-element', type=int, default=0)
+    parser.add_argument('--byte-limit', type=int, default=65536)
+    args = parser.parse_args()
+    try:
+        result = analyze(read_module(args.module), args.binding, args.descriptor_set, args.array_element, args.byte_limit)
+    except (OSError, ValueError, IndexError, TypeError) as error:
+        parser.exit(2, str(error) + '\n')
+    print(json.dumps(result, indent=2))
+
+
+if __name__ == '__main__': main()
diff --git a/vr/build-game.ps1 b/vr/build-game.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..7c9c4f0e73a51191060aed7dc6e26a67cc4a2cf2
--- /dev/null
+++ b/vr/build-game.ps1
@@ -0,0 +1,115 @@
+param(
+    [string]$InstallationRoot = (Join-Path $env:USERPROFILE 'Games/Hookshot'),
+    [string]$BuilderToolsRoot,
+    [ValidateRange(1, 4)][int]$Jobs = 2,
+    [ValidateRange(8, 100)][int]$MinimumFreeGiB = 16,
+    [switch]$PlanOnly,
+    [switch]$SkipLift,
+    [switch]$LiftOnly
+)
+$ErrorActionPreference = 'Stop'
+$projectRoot = [IO.Path]::GetFullPath((Split-Path -Parent $PSScriptRoot))
+$InstallationRoot = (Resolve-Path -LiteralPath $InstallationRoot).Path
+$gameWork = [IO.Path]::GetFullPath((Join-Path $projectRoot 'work/game-build'))
+if (!$gameWork.StartsWith($projectRoot + [IO.Path]::DirectorySeparatorChar, [StringComparison]::OrdinalIgnoreCase) -or
+    $gameWork.StartsWith($InstallationRoot.TrimEnd('\','/') + [IO.Path]::DirectorySeparatorChar, [StringComparison]::OrdinalIgnoreCase)) {
+    throw 'Build output must be inside this project and outside the installed game.'
+}
+# Do not let an existing junction redirect generated files into the stable game or another directory.
+foreach ($candidate in @((Join-Path $projectRoot 'work'), $gameWork)) {
+    if ((Test-Path -LiteralPath $candidate) -and
+        ((Get-Item -LiteralPath $candidate -Force).Attributes -band [IO.FileAttributes]::ReparsePoint)) {
+        throw "Build directory must not be a link: $candidate"
+    }
+}
+if (!$BuilderToolsRoot) {
+    $versions = Join-Path $env:LOCALAPPDATA 'HookshotBuilder/versions'
+    if (Test-Path -LiteralPath $versions) {
+        $BuilderToolsRoot = Get-ChildItem -LiteralPath $versions -Directory |
+            Sort-Object LastWriteTime -Descending | ForEach-Object {
+                $candidate = Join-Path $_.FullName 'HookshotBuilder/tools'
+                if (Test-Path -LiteralPath (Join-Path $candidate 'python/python.exe')) { $candidate }
+            } | Select-Object -First 1
+    }
+}
+if (!$BuilderToolsRoot) { throw 'Specify -BuilderToolsRoot for an existing Hookshot Builder tool bundle.' }
+$BuilderToolsRoot = (Resolve-Path -LiteralPath $BuilderToolsRoot).Path
+$py = Join-Path $BuilderToolsRoot 'python/python.exe'
+$mingw = Join-Path $BuilderToolsRoot 'llvm-mingw'
+$exefs = Join-Path $InstallationRoot '.hookshot_exefs'
+$romfs = Join-Path $InstallationRoot 'romfs'
+foreach ($file in @($py, (Join-Path $mingw 'bin/clang.exe'), (Join-Path $exefs 'main'),
+                    (Join-Path $exefs 'rtld'), (Join-Path $exefs 'sdk'),
+                    (Join-Path $BuilderToolsRoot 'work/hot_funcs.txt'))) {
+    if (!(Test-Path -LiteralPath $file -PathType Leaf)) { throw "Required input is missing: $file" }
+}
+if (!(Test-Path -LiteralPath $romfs -PathType Container)) { throw 'Installed RomFS folder is missing.' }
+. (Join-Path $PSScriptRoot 'compatibility.ps1')
+$buildId=Assert-VrSupportedInstallation $projectRoot $InstallationRoot
+$drive = [IO.DriveInfo]::new([IO.Path]::GetPathRoot($gameWork))
+if ($drive.AvailableFreeSpace -lt ($MinimumFreeGiB * 1GB)) {
+    throw "Less than $MinimumFreeGiB GiB free on the build drive. No build started."
+}
+& $py -I -B -c 'import lz4,numpy,capstone,unicorn,zstandard'
+if ($LASTEXITCODE -ne 0) { throw 'The selected Builder Python lacks required packages.' }
+[ordered]@{
+    source = $projectRoot
+    read_only_game_input = $InstallationRoot
+    generated_files = $gameWork
+    output = (Join-Path $gameWork 'sa/build')
+    romfs_copied = $false
+    game_launched = $false
+    jobs = $Jobs
+    free_GiB = [math]::Round($drive.AvailableFreeSpace / 1GB, 1)
+} | ConvertTo-Json
+if ($PlanOnly) { return }
+
+$env:PYTHONDONTWRITEBYTECODE = '1'
+$env:OOT_WORK = $gameWork
+$env:OOT_EXEFS = $exefs
+$env:OOT_ROMFS = $romfs
+$env:HOOKSHOT_MINGW = $mingw
+$env:RX_CPM = Join-Path $BuilderToolsRoot 'cpm'
+$env:RX_RELEASE = '1'
+$env:A64_HOT_CHUNK = '1'
+$env:WGPU_NATIVE = Join-Path $BuilderToolsRoot 'wgpu-native'
+$env:PATH = (Join-Path $mingw 'bin') + ';' + $env:PATH
+Remove-Item Env:RX_VK_ONLY -ErrorAction SilentlyContinue
+Remove-Item Env:RX_PGO -ErrorAction SilentlyContinue
+New-Item -ItemType Directory -Path (Join-Path $gameWork 'image') -Force | Out-Null
+foreach ($name in @('hot_funcs.txt', 'hot_order.txt', 'hookshot_pieces.prof', 'hookshot.res')) {
+    $source = Join-Path $BuilderToolsRoot ('work/' + $name)
+    $target = Join-Path $gameWork $name
+    if (!$SkipLift -and (Test-Path -LiteralPath $source)) { Copy-Item -LiteralPath $source -Destination $target }
+}
+$env:A64_HOT_FUNCS = Join-Path $gameWork 'hot_funcs.txt'
+$profile = Join-Path $gameWork 'hookshot_pieces.prof'
+if (Test-Path -LiteralPath $profile) { $env:RX_PGO = $profile }
+$chunks = Join-Path $BuilderToolsRoot 'work/image/chunks.txt'
+if (!$SkipLift -and (Test-Path -LiteralPath $chunks)) {
+    Copy-Item -LiteralPath $chunks -Destination (Join-Path $gameWork 'image/chunks.txt')
+}
+Push-Location -LiteralPath $projectRoot
+try {
+    if (!$SkipLift) {
+        & $py -I -B -u nx2/lift.py --standalone --write --work $gameWork --exefs $exefs
+        if ($LASTEXITCODE -ne 0) { throw 'Source translation failed; see the local build log.' }
+        $hotWhole = Join-Path $gameWork 'sa/gen/code_hot.c'
+        if (Test-Path -LiteralPath $hotWhole) {
+            & $py -I -B -u nx2/split_hot.py (Join-Path $gameWork 'sa/gen')
+            if ($LASTEXITCODE -ne 0) { throw 'Hot function partitioning failed.' }
+        }
+    } elseif (!(Test-Path -LiteralPath (Join-Path $gameWork 'sa/gen/hos_image.c')) -or
+              !(Test-Path -LiteralPath $env:A64_HOT_FUNCS) -or
+              !(Get-ChildItem -LiteralPath (Join-Path $gameWork 'sa/gen') -Filter 'code_hot_*.c' -ErrorAction SilentlyContinue)) {
+        throw '-SkipLift requires an already completed translation from the current source.'
+    }
+    if ($LiftOnly) { Write-Output 'Translation completed; native compilation not requested.'; return }
+    if ($drive.AvailableFreeSpace -lt (8GB)) { throw 'Less than 8 GiB remain after translation. Compile not started.' }
+    $sourceBefore=Get-VrSourceFingerprint $projectRoot $py
+    & $py -I -B -u nx2/build.py --standalone --jobs $Jobs
+    if ($LASTEXITCODE -ne 0) { throw 'Native compilation failed; see the local build log.' }
+    if((Get-VrSourceFingerprint $projectRoot $py) -ne $sourceBefore){throw 'Sources changed during compilation; no build receipt issued.'}
+    Write-VrBuildReceipt $projectRoot (Join-Path $gameWork 'build-info.json') (Join-Path $gameWork 'sa/build/hookshot_vk.dll') (Join-Path $gameWork 'sa/build/hookshot.exe') $sourceBefore ([bool]$env:HOOKSHOT_OPENXR_SDK)
+    Write-Output 'Experimental binaries built. No game was launched or installed.'
+} finally { Pop-Location }
