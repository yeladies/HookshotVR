diff --git a/gpu/vk/xr_image_lineage.h b/gpu/vk/xr_image_lineage.h
new file mode 100644
index 0000000000000000000000000000000000000000..d1a296b1a1ae95a5ded68269474be51db4edeb60
--- /dev/null
+++ b/gpu/vk/xr_image_lineage.h
@@ -0,0 +1,120 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <array>
+#include <algorithm>
+#include <cstddef>
+#include <utility>
+#include <set>
+#include <cstdint>
+#include <vector>
+#include <map>
+namespace mkwvk {
+enum class ImageWorkKind { Graphics, Compute, Replacement, Transfer, Clear };
+struct BufferSpan {
+    uint64_t object=0,offset=0,size=0;
+    bool valid()const{return object&&size&&offset<=UINT64_MAX-size;}
+};
+inline bool buffer_overlap(const BufferSpan& a,const BufferSpan& b){return a.valid()&&b.valid()&&a.object==b.object&&a.offset<b.offset+b.size&&b.offset<a.offset+a.size;}
+struct BufferUse {BufferSpan range;bool written=false;};
+struct BufferVersion {BufferSpan range;uint64_t version=0;bool dependent=false;};
+struct ImageWork {
+    ImageWorkKind kind=ImageWorkKind::Graphics;
+    uint64_t program=0;
+    bool camera_seed=false,opaque_buffers=false,truncated=false;
+    uint32_t width=0,height=0;
+    std::vector<uint64_t> reads,writes;
+    std::vector<BufferUse> buffers;
+};
+struct ImageResourceDescription {
+    uint64_t image=0,allocation_bytes=0;
+    uint32_t format=0,width=0,height=0,depth=0,levels=0,layers=0,samples=0,aspect=0,type=0;
+    bool sparse=false;
+};
+struct ImageVersion {uint64_t image=0,version=0;bool dependent=false;};
+struct ImageWorkRecord {ImageWork work;bool dependent=false;std::vector<ImageVersion> inputs,outputs;std::vector<BufferVersion> buffer_inputs,buffer_outputs;};
+struct ImageGraphStats {uint64_t events=0,seeds=0,dependent_graphics=0,dependent_compute=0,shared=0,opaque=0;bool overflow=false;};
+// Conservative whole-image lineage. Does not prove shader access, subresource coverage or replay safety.
+class FrameImageGraph {
+    std::map<uint64_t,ImageVersion> images_;
+    std::map<uint64_t,ImageResourceDescription> descriptions_;
+    std::vector<ImageWorkRecord> records_;
+    ImageGraphStats stats_{};
+    std::vector<BufferVersion> buffer_writes_;uint64_t buffer_version_=0;
+public:
+    static constexpr size_t max_events=4096,max_images=2048,max_bindings=64,max_buffer_writes=4096,max_buffer_inputs=512;
+    void reset(){descriptions_.clear();images_.clear();records_.clear();stats_={};buffer_writes_.clear();buffer_version_=0;}
+    void describe(ImageResourceDescription description) {
+        if(!description.image||!description.format||!description.width||!description.height||!description.depth||!description.levels||!description.layers||!description.samples) {
+            stats_.overflow=true;return;
+        }
+        if(!descriptions_.count(description.image)&&descriptions_.size()>=max_images){stats_.overflow=true;return;}
+        auto it=descriptions_.find(description.image);
+        if(it!=descriptions_.end()) {
+            const auto& old=it->second;
+            if(old.format!=description.format||old.width!=description.width||old.height!=description.height||old.depth!=description.depth||
+               old.layers!=description.layers||old.levels!=description.levels||old.samples!=description.samples||old.aspect!=description.aspect||old.type!=description.type) {
+                stats_.overflow=true;return;
+            }
+            description.allocation_bytes=std::max(description.allocation_bytes,old.allocation_bytes);
+        }
+        descriptions_[description.image]=description;
+    }
+    const std::map<uint64_t,ImageResourceDescription>& descriptions()const{return descriptions_;}    void observe(ImageWork work) {
+        if(records_.size()>=max_events||work.reads.size()>max_bindings||work.writes.size()>max_bindings||work.buffers.size()>max_bindings||work.truncated) {
+            stats_.overflow=true;return;
+        }
+        size_t new_buffers=0;
+        for(const auto& use:work.buffers){if(!use.range.valid()){stats_.overflow=true;return;}if(use.written)++new_buffers;}
+        if(buffer_writes_.size()+new_buffers>max_buffer_writes){stats_.overflow=true;return;}
+        std::set<uint64_t> new_images;
+        for(uint64_t id:work.writes)if(id&&!images_.count(id))new_images.insert(id);
+        if(images_.size()+new_images.size()>max_images){stats_.overflow=true;return;}
+        ImageWorkRecord record{};record.dependent=work.camera_seed;record.work=std::move(work);
+        for(uint64_t id:record.work.reads)if(id) {
+            auto it=images_.find(id);const auto prior=it==images_.end()?ImageVersion{id,0,false}:it->second;
+            record.inputs.push_back(prior);record.dependent|=prior.dependent;
+        }
+        // Attachment blending and partial storage writes may retain earlier destination pixels.
+        // Read-modify-write is conservative for written storage ranges too. Keep imported baseline explicit.
+        std::set<uint64_t> seen_buffer_versions;
+        for(const auto& use:record.work.buffers) {
+            record.buffer_inputs.push_back({use.range,0,false});
+            for(const auto& prior:buffer_writes_)if(buffer_overlap(use.range,prior.range)&&seen_buffer_versions.insert(prior.version).second) {
+                record.buffer_inputs.push_back(prior);record.dependent|=prior.dependent;
+                if(record.buffer_inputs.size()>max_buffer_inputs){stats_.overflow=true;return;}
+            }
+        }
+        for(uint64_t id:record.work.writes)if(id) {
+            auto it=images_.find(id);if(it!=images_.end()) {
+                record.dependent|=it->second.dependent;
+                bool found=false;for(const auto& prior:record.inputs)if(prior.image==id&&prior.version==it->second.version)found=true;
+                if(!found)record.inputs.push_back(it->second);
+            }
+        }
+        for(uint64_t id:record.work.writes)if(id) {
+            bool duplicate=false;for(const auto& out:record.outputs)if(out.image==id)duplicate=true;
+            if(duplicate)continue;
+            if(!images_.count(id)&&images_.size()>=max_images){stats_.overflow=true;return;}
+            auto& latest=images_[id];latest={id,latest.version+1,record.dependent};record.outputs.push_back(latest);
+        }
+        for(const auto& use:record.work.buffers)if(use.written) {
+            BufferVersion version{use.range,++buffer_version_,record.dependent};buffer_writes_.push_back(version);record.buffer_outputs.push_back(version);
+        }
+        ++stats_.events;if(record.work.camera_seed)++stats_.seeds;
+        if(record.work.opaque_buffers)++stats_.opaque;
+        if(!record.dependent)++stats_.shared;
+        else if(record.work.kind==ImageWorkKind::Graphics)++stats_.dependent_graphics;
+        else ++stats_.dependent_compute;
+        records_.push_back(std::move(record));
+    }
+    bool dependent(uint64_t image) const {auto it=images_.find(image);return it!=images_.end()&&it->second.dependent;}
+    const ImageGraphStats& stats() const{return stats_;}
+    const std::vector<ImageWorkRecord>& records()const{return records_;}
+    // Copies, aliases, hidden pointers and subresources are not completely covered by this observer.
+    bool replay_ready()const{return false;}
+};
+bool xr_image_lineage_enabled();
+void xr_image_lineage_work(uint64_t frame,ImageWork);
+void xr_image_lineage_resource(uint64_t frame,ImageResourceDescription);
+void xr_image_lineage_present(uint64_t frame,uint64_t image);
+}
diff --git a/gpu/vk/xr_immersive_camera.h b/gpu/vk/xr_immersive_camera.h
new file mode 100644
index 0000000000000000000000000000000000000000..6131d34f046ff29ea4c0dfea3875c9a17e419ff6
--- /dev/null
+++ b/gpu/vk/xr_immersive_camera.h
@@ -0,0 +1,87 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <array>
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+namespace mkwvk {
+struct ImmersiveTag {
+    bool valid=false,menu=false,temporal_stereo=false;uint32_t eye=0;uint64_t generation=0;int64_t observed_ns=0;
+    float orientation[4]{0,0,0,1},position[3]{},fov[4]{};
+};
+struct ImmersivePose {float q[4]{0,0,0,1},p[3]{};bool temporal_stereo=false;uint32_t eye=0;uint64_t generation=0;int64_t observed_ns=0;};
+// Bounded head/eye camera math. Temporal stereo uses distinct game presents.
+// No guest pointers or XR API are accessed by this helper.
+class ImmersiveCamera {
+    uint64_t camera_=0,generation_=0;float reference_[9]{},origin_[3]{},base_[12]{},last_[12]{};
+    bool anchored_=false;struct History {float view[12]{};ImmersivePose pose;bool valid=false;};
+    std::array<History,64> history_{};unsigned cursor_=0;
+    static bool rotation(const float* q,float* r){
+        double n=0;for(int i=0;i<4;++i){if(!std::isfinite(q[i]))return false;n+=double(q[i])*q[i];}
+        if(std::abs(n-1)>0.01)return false;
+        const double x=q[0]/std::sqrt(n),y=q[1]/std::sqrt(n),z=q[2]/std::sqrt(n),w=q[3]/std::sqrt(n);
+        const double a[9]={1-2*(y*y+z*z),2*(x*y-z*w),2*(x*z+y*w),2*(x*y+z*w),1-2*(x*x+z*z),2*(y*z-x*w),2*(x*z-y*w),2*(y*z+x*w),1-2*(x*x+y*y)};
+        for(int i=0;i<9;++i)r[i]=float(a[i]);return true;
+    }
+    static bool rigid(const float* v){
+        for(int i=0;i<12;++i)if(!std::isfinite(v[i]))return false;
+        for(int r=0;r<3;++r)for(int s=0;s<3;++s){double dot=0;for(int c=0;c<3;++c)dot+=double(v[4*r+c])*v[4*s+c];if(std::abs(dot-(r==s))>0.002)return false;}
+        const double d=v[0]*(double(v[5])*v[10]-double(v[6])*v[9])-v[1]*(double(v[4])*v[10]-double(v[6])*v[8])+v[2]*(double(v[4])*v[9]-double(v[5])*v[8]);
+        return std::abs(d-1)<0.003;
+    }
+public:
+    bool apply(uint64_t camera,float* view,const ImmersivePose& pose,int64_t now,const ImmersivePose* anchor=nullptr){
+        float current[9];if(!camera||!pose.generation||pose.observed_ns<=0||now<pose.observed_ns||now-pose.observed_ns>250000000||!rigid(view)||!rotation(pose.q,current))return false;
+        for(float x:pose.p)if(!std::isfinite(x))return false;
+        if(pose.temporal_stereo&&pose.eye>1)return false;
+        float reference_rotation[9];const auto& reference=anchor?*anchor:pose;
+        if(reference.generation!=pose.generation||reference.observed_ns<=0||now<reference.observed_ns||now-reference.observed_ns>250000000||!rotation(reference.q,reference_rotation))return false;
+        for(float x:reference.p)if(!std::isfinite(x))return false;
+        const bool reset=!anchored_||camera_!=camera||generation_!=pose.generation;
+        if(reset){camera_=camera;generation_=pose.generation;std::memcpy(reference_,reference_rotation,sizeof reference_rotation);std::memcpy(origin_,reference.p,sizeof origin_);anchored_=true;for(auto& h:history_)h.valid=false;}
+        // The engine may revisit the same view without rebuilding it. Never feed
+        // a previously overridden matrix back into the relative transformation.
+        if(reset||std::memcmp(view,last_,sizeof last_)!=0)std::memcpy(base_,view,sizeof base_);
+        float delta[9]{},translation[3]{};
+        for(int r=0;r<3;++r){for(int k=0;k<3;++k)translation[r]+=reference_[3*k+r]*(pose.p[k]-origin_[k]);
+            for(int c=0;c<3;++c)for(int k=0;k<3;++k)delta[3*r+c]+=reference_[3*k+r]*current[3*k+c];}
+        double distance=0;for(float x:translation)distance+=double(x)*x;
+        if(distance>1.0)return false; // First test: at most one metre from the anchor.
+        float out[12]{};for(int r=0;r<3;++r)for(int c=0;c<4;++c)for(int k=0;k<3;++k)
+            out[4*r+c]+=delta[3*k+r]*(base_[4*k+c]-(c==3?translation[k]:0));
+        if(!rigid(out))return false;
+        std::memcpy(view,out,sizeof out);std::memcpy(last_,out,sizeof out);
+        auto& h=history_[cursor_++%history_.size()];std::memcpy(h.view,out,sizeof out);h.pose=pose;h.valid=true;return true;
+    }
+    ImmersiveTag match(const float* view,const float* projection,int64_t now)const{
+        ImmersiveTag out;if(!rigid(view))return out;
+        for(int i=0;i<16;++i)if(!std::isfinite(projection[i]))return out;
+        if(projection[0]<=0||std::abs(projection[5])<0.000001||std::abs(projection[14]+1)>0.000001)return out;
+        for(int i:{1,3,4,7,8,9,12,13,15})if(std::abs(projection[i])>0.000001)return out;
+        for(unsigned n=0;n<history_.size();++n){const auto& h=history_[(cursor_-1-n)%history_.size()];
+            if(!h.valid||h.pose.generation!=generation_||now<h.pose.observed_ns||now-h.pose.observed_ns>250000000)continue;
+            bool same=true;for(int i=0;i<12;++i)same&=std::abs(double(h.view[i])-view[i])<0.0001;if(!same)continue;
+            out.valid=true;out.temporal_stereo=h.pose.temporal_stereo;out.eye=h.pose.eye;out.generation=h.pose.generation;out.observed_ns=h.pose.observed_ns;std::memcpy(out.orientation,h.pose.q,sizeof out.orientation);std::memcpy(out.position,h.pose.p,sizeof out.position);
+            out.fov[0]=std::atan((projection[2]-1)/projection[0]);out.fov[1]=std::atan((projection[2]+1)/projection[0]);
+            out.fov[2]=std::atan((projection[6]+1)/std::abs(projection[5]));out.fov[3]=std::atan((projection[6]-1)/std::abs(projection[5]));return out;
+        }
+        return out;
+    }
+};
+inline bool immersive_lens_from_fovs(const float left[4],const float right[4],float& vertical,float& aspect,float tangent_scale=1.f){
+    if(!std::isfinite(tangent_scale)||tangent_scale<1||tangent_scale>1.65f)return false;
+    double horizontal=0,height=0;
+    for(const auto* eye:{left,right}){
+        if(!eye)return false;
+        for(int i=0;i<4;++i)if(!std::isfinite(eye[i])||std::abs(eye[i])>=1.45)return false;
+        if(eye[0]>=0||eye[1]<=0||eye[2]<=0||eye[3]>=0)return false;
+        horizontal=std::max(horizontal,std::max(-std::tan(double(eye[0])),std::tan(double(eye[1]))));
+        height=std::max(height,std::max(std::tan(double(eye[2])),-std::tan(double(eye[3]))));
+    }
+    const double fov=2*std::atan(height*tangent_scale),ratio=horizontal/height;
+    if(!std::isfinite(ratio)||fov<.2||fov>2.8||height*tangent_scale>=2.8||ratio<.5||ratio>2.5)return false;
+    vertical=float(fov);aspect=float(ratio);return true;
+}
+
+}
diff --git a/gpu/vk/xr_matrix_patch_check.h b/gpu/vk/xr_matrix_patch_check.h
new file mode 100644
index 0000000000000000000000000000000000000000..9b7f50189ac21312580045ff984c3fce8aae91e3
--- /dev/null
+++ b/gpu/vk/xr_matrix_patch_check.h
@@ -0,0 +1,32 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include "xr_eye_uniform_copy.h"
+#include "xr_projection_constants.h"
+namespace mkwvk {
+// Source before/after and two unbound private patches. Does not validate a game draw.
+inline bool xr_matrix_patch_payloads(const unsigned char* data,size_t bytes,size_t range,bool lens=false,float magnitude=.01f,bool raw_view_diagnostic=false,bool projection_constants=false,uint32_t width=0,uint32_t height=0){
+    using namespace hookshot::vr;
+    if(!data||range<0x230||range>65536||range%4||!std::isfinite(magnitude)||magnitude<=0||magnitude>(raw_view_diagnostic&&!lens?8.f:.05f)||bytes!=4*range||std::memcmp(data,data+range,range))return false;
+    if(projection_constants){float constants[76];std::memcpy(constants,data,sizeof constants);
+        if(!raw_view_diagnostic||lens||!xr_projection_constants_valid(constants,76,width,height))return false;}
+
+    float base[56];std::memcpy(base,data,sizeof base);
+    float translations[2]{};
+    for(unsigned eye=0;eye<2;++eye){
+        EyeMatrices matrix{};for(int r=0;r<3;++r)for(int c=0;c<4;++c)matrix.view.rows[r][c]=base[4*r+c];
+        translations[eye]=float(base[3]+(lens?0:(eye?magnitude:-magnitude)));matrix.view.rows[0][3]=translations[eye];
+        float view[12],inverse[12];for(int i=0;i<12;++i)view[i]=float(matrix.view.rows[i/4][i%4]);
+        uniform_detail::inverse(view,inverse);for(int r=0;r<3;++r)matrix.view.eye[r]=inverse[4*r+3];
+        for(int i=0;i<16;++i)matrix.projection[i]=base[28+i];
+        if(lens){translations[eye]=float(base[30]+(eye?-magnitude:magnitude));matrix.projection[2]=translations[eye];}
+        for(int r=0;r<4;++r)for(int c=0;c<4;++c)for(int k=0;k<4;++k)
+            matrix.world_to_clip[4*r+c]+=matrix.projection[4*r+k]*(k==3?(c==3?1:0):matrix.view.rows[k][c]);
+        std::vector<std::byte> expected;if(!prepare_eye_uniform_copy(data,range,matrix,ClipDepth::MinusOneToOne,expected))return false;
+        const auto* actual=data+(eye+2)*range;
+        if(std::memcmp(actual,expected.data(),0x30)||std::memcmp(actual+0x70,expected.data()+0x70,0x40)||std::memcmp(actual+0xe0,data+0xe0,range-0xe0))return false;
+        float got[56],wanted[56];std::memcpy(got,actual,sizeof got);std::memcpy(wanted,expected.data(),sizeof wanted);
+        for(int i=12;i<56;++i)if(!std::isfinite(got[i])||std::abs(got[i]-wanted[i])>0.00003f*(1+std::abs(wanted[i])))return false;
+    }
+    return translations[0]!=translations[1]; // A rounded-away displacement is inconclusive.
+}
+}
diff --git a/gpu/vk/xr_native_eye_draw_check.h b/gpu/vk/xr_native_eye_draw_check.h
new file mode 100644
index 0000000000000000000000000000000000000000..779d8877f4559f7cd05ea6201490e6af4b18df39
--- /dev/null
+++ b/gpu/vk/xr_native_eye_draw_check.h
@@ -0,0 +1,36 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+namespace mkwvk {
+struct XrNativeEyeDrawComparison {
+    bool complete=false,controls_match=false,eyes_changed=false;
+    std::array<uint64_t,2> changed_from_control{},visible_pixels{};
+    uint64_t eye_pair_differences=0;
+};
+// Six snapshots: source before/after, two unchanged controls, two native-eye
+// isolated draws. Native FOVs may be asymmetric: do not impose a symmetric
+// centroid shift, fixed pixel disparity, or the legacy artificial lens offset.
+// Image differences demonstrate raster activity only, never whole-scene stereo.
+inline XrNativeEyeDrawComparison compare_xr_native_eye_draw(const void* data,size_t available,uint32_t width,uint32_t height){
+    XrNativeEyeDrawComparison out;
+    if(!data||!width||!height||width>4096||height>4096)return out;
+    const uint64_t pixels=uint64_t(width)*height,frame=pixels*4;
+    if(available!=6*frame)return out;
+    const auto* bytes=static_cast<const unsigned char*>(data);
+    out.complete=true;
+    out.controls_match=!std::memcmp(bytes+frame,bytes+2*frame,size_t(frame))&&!std::memcmp(bytes+frame,bytes+3*frame,size_t(frame));
+    for(uint64_t i=0;i<pixels;++i){const auto offset=i*4;
+        for(unsigned eye=0;eye<2;++eye){const auto* pixel=bytes+(eye+4)*frame+offset;
+            out.changed_from_control[eye]+=std::memcmp(pixel,bytes+frame+offset,4)!=0;
+            out.visible_pixels[eye]+=std::memcmp(pixel,bytes+offset,4)!=0;
+        }
+        out.eye_pair_differences+=std::memcmp(bytes+4*frame+offset,bytes+5*frame+offset,4)!=0;
+    }
+    out.eyes_changed=out.controls_match&&out.changed_from_control[0]>=16&&out.changed_from_control[1]>=16&&
+        out.visible_pixels[0]>=16&&out.visible_pixels[1]>=16&&out.eye_pair_differences>=4;
+    return out;
+}
+}
diff --git a/gpu/vk/xr_native_eye_patch.h b/gpu/vk/xr_native_eye_patch.h
new file mode 100644
index 0000000000000000000000000000000000000000..beed23023efc26cecacf0eaf872632459d63a961
--- /dev/null
+++ b/gpu/vk/xr_native_eye_patch.h
@@ -0,0 +1,74 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include "xr_first_person_uniform_copy.h"
+namespace mkwvk {
+// The caller must obtain this tag from the owned submission observation, not
+// infer frame identity from equal matrix values or resample a present counter.
+struct XrNativeEyeSource {
+    int64_t game_present=-1;
+    uint64_t nvn_submit=0,recording=0,guest_camera=0; // canonical NVN uniform address for root indirection.
+    uint64_t writer_guest_camera=0; // CPU guest destination from the guarded uniform writer.
+};
+struct XrNativeEyePatch {
+    static constexpr size_t prefix_bytes=0xe0;
+    XrNativeEyeSource source{};
+    uint64_t tracking_sequence=0,origin_generation=0;
+    int64_t predicted_display_time=0,observed_ns=0;
+    size_t source_bytes=0;
+    alignas(4) std::array<std::byte,prefix_bytes> original_prefix{};
+    alignas(4) std::array<std::array<std::byte,prefix_bytes>,2> eye_prefixes{};
+};
+inline bool xr_native_eye_patch_shape(const XrNativeEyePatch& patch){
+    return patch.source.game_present>=0&&patch.source.nvn_submit&&patch.source.recording&&patch.source.guest_camera&&patch.source.writer_guest_camera&&
+        patch.tracking_sequence&&patch.origin_generation&&patch.predicted_display_time>0&&patch.observed_ns>0&&
+        patch.source_bytes>=0x230&&patch.source_bytes<=65536&&patch.source_bytes%4==0&&
+        patch.eye_prefixes[0]!=patch.eye_prefixes[1];
+}
+// Prefix payloads only. The GPU recorder must clone the actual source buffer
+// first, then overlay these 224 bytes. Never upload a CPU snapshot of the tail.
+// CPU availability and the declared GPU extent are separate: only 0x230 CPU
+// bytes are inspected/copied, even when the actual GPU camera is much larger.
+// This is not a certificate for unknown shader reads, scene replay or XR layers.
+inline bool prepare_xr_native_eye_patch(const XrNativeEyeSource& tag,const void* source,size_t cpu_bytes,size_t gpu_bytes,
+                                        const FirstPersonProjectionPacket& packet,XrNativeEyePatch& out)noexcept{
+    try{
+    if(cpu_bytes<0x230||cpu_bytes>65536||gpu_bytes<0x230||gpu_bytes>65536||gpu_bytes%4)return false;
+    if(!source||tag.game_present!=packet.game_present||!tag.nvn_submit||!tag.recording||!tag.guest_camera||!tag.writer_guest_camera)return false;
+    const auto first=reinterpret_cast<uintptr_t>(source),last=reinterpret_cast<uintptr_t>(&out);
+    if(first>UINTPTR_MAX-cpu_bytes||last>UINTPTR_MAX-sizeof(out)||
+       (first<last+sizeof(out)&&last<first+cpu_bytes))return false;
+    std::array<std::vector<std::byte>,2> copies;
+    if(!prepare_first_person_primary_uniform_copies(source,0x230,packet,copies))return false;
+    XrNativeEyePatch next{};next.source=tag;next.source_bytes=gpu_bytes;
+    next.tracking_sequence=packet.tracking.sequence;next.origin_generation=packet.tracking.origin_generation;
+    next.predicted_display_time=packet.tracking.predicted_display_time;next.observed_ns=packet.observed_ns;
+    std::memcpy(next.original_prefix.data(),source,next.prefix_bytes);
+    for(unsigned eye=0;eye<2;++eye)std::memcpy(next.eye_prefixes[eye].data(),copies[eye].data(),next.prefix_bytes);
+    if(!xr_native_eye_patch_shape(next))return false;
+    out=next;return true;
+    }catch(...){return false;} // An optional experiment must never fail the source draw.
+}
+struct XrNativeEyeReadback {
+    bool complete=false,source_prefix_matched=false,source_unchanged=false,verified=false;
+    std::array<bool,2> eye_prefix_matched{},gpu_tail_preserved{};
+};
+// Four completed GPU buffer readbacks: source before/after, then left/right.
+// GPU-only changes in opaque tail fields are preserved, even when they differ
+// from the CPU submission snapshot used to identify the primary camera.
+inline XrNativeEyeReadback verify_xr_native_eye_readback(const XrNativeEyePatch& patch,const void* bytes,size_t available){
+    XrNativeEyeReadback result{};
+    if(!bytes||!xr_native_eye_patch_shape(patch)||available!=4*patch.source_bytes)return result;
+    const auto* data=static_cast<const std::byte*>(bytes);const auto n=patch.source_bytes,p=patch.prefix_bytes;
+    result.complete=true;
+    result.source_prefix_matched=std::memcmp(data,patch.original_prefix.data(),p)==0;
+    result.source_unchanged=std::memcmp(data,data+n,n)==0;
+    result.verified=result.source_prefix_matched&&result.source_unchanged;
+    for(unsigned eye=0;eye<2;++eye){
+        const auto* copied=data+(eye+2)*n;
+        result.eye_prefix_matched[eye]=std::memcmp(copied,patch.eye_prefixes[eye].data(),p)==0;
+        result.gpu_tail_preserved[eye]=std::memcmp(copied+p,data+p,n-p)==0;
+        result.verified&=result.eye_prefix_matched[eye]&&result.gpu_tail_preserved[eye];
+    }
+    return result;
+}
+}
diff --git a/gpu/vk/xr_preview_capture.h b/gpu/vk/xr_preview_capture.h
new file mode 100644
index 0000000000000000000000000000000000000000..4d7e758fe3b2f9f2e57fa318baddd06b6bdcec50
--- /dev/null
+++ b/gpu/vk/xr_preview_capture.h
@@ -0,0 +1,39 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include "xr_preview_feed.h"
+#include <filesystem>
+#include <fstream>
+#include <string>
+namespace mkwvk {
+// Optional private, offscreen-only diagnostic: at most three stereo pairs and
+// one subsequent menu. Caller owns mode/path validation; no game data enters CI.
+class PreviewCapture {
+    std::filesystem::path root_;uint64_t pairs_=0;unsigned written_=0;bool seen_pair_=false,menu_written_=false;
+    bool ppm(const std::filesystem::path& path,const std::shared_ptr<const std::vector<uint8_t>>& pixels,uint32_t width,uint32_t height){
+        if(!pixels||!width||!height||width>1920||height>1080||pixels->size()!=uint64_t(width)*height*4||std::filesystem::exists(path))return false;
+        std::vector<uint8_t> rgb(uint64_t(width)*height*3);
+        for(size_t i=0;i<rgb.size()/3;++i)for(unsigned c=0;c<3;++c)rgb[3*i+c]=(*pixels)[4*i+c];
+        std::ofstream out(path,std::ios::binary);if(!out)return false;
+        out<<"P6\n"<<width<<' '<<height<<"\n255\n";out.write(reinterpret_cast<const char*>(rgb.data()),std::streamsize(rgb.size()));return bool(out);
+    }
+public:
+    explicit PreviewCapture(const std::string& root):root_(std::filesystem::u8path(root)){}
+    bool offer(const PreviewFrame& frame){
+        if(!frame.pixels||!frame.width||!frame.height||frame.width>1920||frame.height>1080||frame.pixels->size()!=uint64_t(frame.width)*frame.height*4||(frame.right_pixels&&frame.right_pixels->size()!=frame.pixels->size()))return false;
+        if(root_.empty()||!std::filesystem::is_directory(root_)||std::filesystem::is_symlink(root_))return false;
+        if(frame.right_pixels){
+            seen_pair_=true;const auto pair=++pairs_;
+            if(written_>=3||(pair-1)%60)return false;
+            const auto stem="pair-"+std::to_string(++written_);
+            if(std::filesystem::exists(root_/(stem+".json")))return false;
+            const bool left=ppm(root_/(stem+"-left.ppm"),frame.pixels,frame.width,frame.height);
+            const bool right=ppm(root_/(stem+"-right.ppm"),frame.right_pixels,frame.width,frame.height);
+            std::ofstream meta(root_/(stem+".json"));
+            if(meta)meta<<"{\"schema\":1,\"left_present\":"<<frame.game_present<<",\"left_serial\":"<<frame.serial<<",\"right_serial\":"<<frame.right_serial<<",\"temporal_stereo\":true,\"headset_capture\":false,\"horizontal_fov_rad\":"<<frame.immersive.fov[1]-frame.immersive.fov[0]<<",\"vertical_fov_rad\":"<<frame.immersive.fov[2]-frame.immersive.fov[3]<<"}\n";
+            return left&&right&&bool(meta);
+        }
+        if(seen_pair_&&frame.immersive.menu&&!menu_written_){menu_written_=true;return ppm(root_/"menu.ppm",frame.pixels,frame.width,frame.height);}
+        return false;
+    }
+};
+}
