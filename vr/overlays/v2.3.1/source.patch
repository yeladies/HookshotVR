+        checked(gpu.api.create_buffer(c.device,&bi,nullptr,&c.staging),"create bounded readback");VkMemoryRequirements req{};gpu.api.buffer_requirements(c.device,c.staging,&req);
+        require(req.size&&req.size<=1024*1024,"readback allocation budget");uint32_t type=UINT32_MAX;bool coherent=false;
