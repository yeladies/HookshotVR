+    check(!query(UINT64_MAX-3,8)&&!query(8192,4)&&!query(0,0)&&!query(1,4)&&!query(0,3),"sparse extent and alignment guards");
+    auto sparseRejected=[&]{out.resident_bytes=777;check(!query(256,560)&&out.resident_bytes==777,"rejected sparse query is atomic");};
+    for(unsigned reason=0;reason<11;++reason){auto& p=imported.begin()->second;p=sparse;
+        if(reason==0)p.has[0]=0;if(reason==1)p.blocks[0]=0;if(reason==2)p.released[0]=1;if(reason==3)p.last_bound[0]=8;
+        if(reason==4)p.sparse_block_bytes=0;if(reason==5)p.sparse_block_bytes=3000;if(reason==6)p.sparse_size=4096;
+        if(reason==7)p.last_bound.clear();if(reason==8)p.refill={{256,4}};if(reason==9)p.refill={{UINT64_MAX-3,8}};
