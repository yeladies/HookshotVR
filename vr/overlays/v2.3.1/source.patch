+        checked(gpu.api.allocate(c.device,&ai,nullptr,&c.memory),"allocate readback");checked(gpu.api.bind_buffer(c.device,c.staging,c.memory,0),"bind readback");
+        VkCommandPoolCreateInfo pool{VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO};pool.queueFamilyIndex=gpu.family;
+        checked(c.fn<PFN_vkCreateCommandPool>("vkCreateCommandPool")(c.device,&pool,nullptr,&c.pool),"create command pool");
+        VkCommandBufferAllocateInfo allocate{VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO};allocate.commandPool=c.pool;allocate.level=VK_COMMAND_BUFFER_LEVEL_PRIMARY;allocate.commandBufferCount=1;VkCommandBuffer command;
