+        if($r.width_per_eye -lt 2 -or $r.width_per_eye -gt 1920 -or $r.height -lt 2 -or $r.height -gt 1080 -or $r.source_states.Count -ne 3 -or $r.recordings.Count -ne 3 -or $r.last_counts.Count -ne 8){return $false}
