diff --git a/gpu/vk/xr_gpu_frame_diagnostics.h b/gpu/vk/xr_gpu_frame_diagnostics.h
new file mode 100644
index 0000000000000000000000000000000000000000..93a83e6c60ffb1540a4b484acd97cb573cf6d42c
--- /dev/null
+++ b/gpu/vk/xr_gpu_frame_diagnostics.h
@@ -0,0 +1,35 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <array>
+#include <cstdint>
+#include <ostream>
+namespace hookshot::vr {
+enum class GpuFrameReason : unsigned {None,SourceUnavailable,SourceStale,InvalidSource,Tracking,OriginChanged,InvalidPair,GpuPending,ImagePending,RuntimeHidden,Suppressed,Failure,Count};
+inline const char* gpu_frame_reason_name(GpuFrameReason reason){
+    constexpr const char* names[]={"none","source_unavailable","source_stale","invalid_source","tracking","origin_changed","invalid_pair","gpu_pending","image_pending","runtime_hidden","suppressed","failure"};
+    return unsigned(reason)<unsigned(GpuFrameReason::Count)?names[unsigned(reason)]:"invalid_reason";
+}
+// Counts layers actually accepted by xrEndFrame, not the colour of their pixels.
+// Startup is separated from gaps after the first successfully submitted layer.
+struct GpuFrameDiagnostics {
+    uint64_t frames=0,layers=0,startup=0,omitted=0,gaps=0,max_gap_ns=0,current_gap_ns=0;
+    std::array<uint64_t,unsigned(GpuFrameReason::Count)> reasons{},blockers{};
+    int64_t gap_start=0,last_observed=0;bool seen_layer=false,last_layer=false;
+    void observe(bool layer,GpuFrameReason reason,GpuFrameReason blocker,int64_t now){
+        if(now<=0||now<last_observed)return;last_observed=now;++frames;
+        if(layer){++layers;seen_layer=true;if(gap_start){current_gap_ns=uint64_t(now-gap_start);if(current_gap_ns>max_gap_ns)max_gap_ns=current_gap_ns;}gap_start=0;current_gap_ns=0;}
+        else{
+            if(unsigned(reason)>=unsigned(GpuFrameReason::Count)||reason==GpuFrameReason::None)reason=GpuFrameReason::InvalidPair;
+            ++reasons[unsigned(reason)];if(unsigned(blocker)<unsigned(GpuFrameReason::Count)&&blocker!=GpuFrameReason::None)++blockers[unsigned(blocker)];
+            if(!seen_layer)++startup;
+            else{++omitted;if(!gap_start){gap_start=now;++gaps;}current_gap_ns=uint64_t(now-gap_start);if(current_gap_ns>max_gap_ns)max_gap_ns=current_gap_ns;}
+        }
+        last_layer=layer;
+    }
+    void json(std::ostream& out)const{
+        out<<"{\"pixel_blackness_measured\":false,\"frames\":"<<frames<<",\"layers\":"<<layers<<",\"startup_without_layer\":"<<startup<<",\"omitted_after_first_layer\":"<<omitted<<",\"gap_runs\":"<<gaps<<",\"maximum_observed_gap_ns\":"<<max_gap_ns<<",\"current_observed_gap_ns\":"<<current_gap_ns<<",\"reasons\":{";
+        for(unsigned i=1;i<reasons.size();++i){if(i>1)out<<',';out<<'"'<<gpu_frame_reason_name(GpuFrameReason(i))<<"\":"<<reasons[i];}out<<"},\"blocked_new_pair\":{";
+        for(unsigned i=1;i<blockers.size();++i){if(i>1)out<<',';out<<'"'<<gpu_frame_reason_name(GpuFrameReason(i))<<"\":"<<blockers[i];}out<<"}}";
+    }
+};
+}
diff --git a/gpu/vk/xr_gpu_presentation_timing.h b/gpu/vk/xr_gpu_presentation_timing.h
new file mode 100644
index 0000000000000000000000000000000000000000..ee49a7f42005255e421e03b6113dd8b8b74bf584
--- /dev/null
+++ b/gpu/vk/xr_gpu_presentation_timing.h
@@ -0,0 +1,33 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <array>
+#include <cstdint>
+#include <ostream>
+namespace hookshot::vr {
+// CPU monotonic observation ages at successful xrEndFrame return. These are
+// not GPU timestamps, compositor display times or motion-to-photon latency.
+struct GpuPresentationTiming {
+    uint64_t samples=0,reused_pairs=0,pair_runs=0,invalid_samples=0;
+    uint64_t source_age_sum_ns=0,source_age_max_ns=0,eye_age_sum_ns=0,eye_age_max_ns=0,ready_age_sum_ns=0,ready_age_max_ns=0;
+    uint64_t source_to_eye_sum_ns=0,eye_to_ready_sum_ns=0;
+    std::array<uint64_t,6> eye_age_buckets{};
+    uint64_t previous_pair=0,previous_generation=0,previous_origin=0;
+    bool record(uint64_t pair,uint64_t source,uint64_t generation,uint64_t origin,int64_t source_observed,int64_t eye_observed,int64_t ready,int64_t submitted){
+        if(!pair||!source||!generation||!origin||source_observed<=0||eye_observed<source_observed||ready<eye_observed||submitted<ready||submitted-source_observed>5000000000ll){++invalid_samples;return false;}
+        const uint64_t a=uint64_t(submitted-source_observed),b=uint64_t(submitted-eye_observed),c=uint64_t(submitted-ready);
+        if(pair==previous_pair&&generation==previous_generation&&origin==previous_origin)++reused_pairs;else ++pair_runs;
+        previous_pair=pair;previous_generation=generation;previous_origin=origin;++samples;
+        source_age_sum_ns+=a;eye_age_sum_ns+=b;ready_age_sum_ns+=c;
+        if(a>source_age_max_ns)source_age_max_ns=a;if(b>eye_age_max_ns)eye_age_max_ns=b;if(c>ready_age_max_ns)ready_age_max_ns=c;
+        source_to_eye_sum_ns+=uint64_t(eye_observed-source_observed);eye_to_ready_sum_ns+=uint64_t(ready-eye_observed);
+        unsigned bucket=0;for(uint64_t limit:{8000000ull,16000000ull,33000000ull,66000000ull,100000000ull}){if(b<=limit)break;++bucket;}++eye_age_buckets[bucket];return true;
+    }
+    void json(std::ostream& out)const{
+        out<<"{\"clock\":\"CPU_steady_observations_at_xrEndFrame_return\",\"motion_to_photon_measurement\":false,\"samples\":"<<samples<<",\"reused_pairs\":"<<reused_pairs<<",\"pair_runs\":"<<pair_runs<<",\"invalid_samples\":"<<invalid_samples
+           <<",\"source_pose_age_sum_ns\":"<<source_age_sum_ns<<",\"source_pose_age_max_ns\":"<<source_age_max_ns<<",\"eye_pose_age_sum_ns\":"<<eye_age_sum_ns<<",\"eye_pose_age_max_ns\":"<<eye_age_max_ns
+           <<",\"pair_ready_age_sum_ns\":"<<ready_age_sum_ns<<",\"pair_ready_age_max_ns\":"<<ready_age_max_ns<<",\"source_to_eye_sum_ns\":"<<source_to_eye_sum_ns<<",\"eye_to_pair_ready_sum_ns\":"<<eye_to_ready_sum_ns
+           <<",\"eye_age_upper_bounds_ns\":[8000000,16000000,33000000,66000000,100000000,null],\"eye_age_counts\":[";
+        for(unsigned i=0;i<eye_age_buckets.size();++i){if(i)out<<',';out<<eye_age_buckets[i];}out<<"]}";
+    }
+};
+}
diff --git a/gpu/vk/xr_gpu_projection_layer.h b/gpu/vk/xr_gpu_projection_layer.h
new file mode 100644
index 0000000000000000000000000000000000000000..d0f2280d7ef69e847048b446db32093e0dc66e40
--- /dev/null
+++ b/gpu/vk/xr_gpu_projection_layer.h
@@ -0,0 +1,53 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include "xr_depth_pair_tracking.h"
+#include <openxr/openxr.h>
+namespace hookshot::vr {
+// Metadata from one immutable, completed GPU pair, never separate eye presents.
+// GPU allocation/lease ownership is established by the producer/copy owner.
+struct GpuProjectionPair {
+    uint64_t source_state=0,device_generation=0;uint32_t width=0,height=0;
+    int64_t source_observed_ns=0,ready_ns=0;bool immutable=false,complete=false,temporal_source=false;
+    DepthPairTrackingTarget target;
+};
+struct GpuProjectionSwapchain {
+    XrSwapchain chain=XR_NULL_HANDLE;uint64_t device_generation=0;
+    uint32_t width=0,height=0,array_size=0;bool acquired_and_waited=false,pair_copy_completed=false;
+};
+// Keep this object alive through xrEndFrame. Copies are safe: layer() binds the
+// returned view pointer to this object's own array, not a temporary builder.
+struct GpuProjectionData {
+    XrSpace space=XR_NULL_HANDLE;
+    std::array<XrCompositionLayerProjectionView,2> views{{{XR_TYPE_COMPOSITION_LAYER_PROJECTION_VIEW},{XR_TYPE_COMPOSITION_LAYER_PROJECTION_VIEW}}};
+    XrCompositionLayerProjection layer()const{XrCompositionLayerProjection value{XR_TYPE_COMPOSITION_LAYER_PROJECTION};value.space=space;value.viewCount=2;value.views=views.data();return value;}
+};
+inline bool gpu_projection_pair_valid(const GpuProjectionPair& pair,uint64_t origin,int64_t now){
+    const auto& target=pair.target;
+    if(!origin||now<=0||!pair.source_state||!pair.device_generation||!pair.immutable||!pair.complete||pair.temporal_source||!target.serial||target.origin!=origin||
+       pair.source_observed_ns<=0||target.observed_ns<pair.source_observed_ns||pair.ready_ns<target.observed_ns||now<pair.ready_ns||now-pair.source_observed_ns>250000000||
+       pair.width<2||pair.height<2||pair.width>4096||pair.height>4096||uint64_t(pair.width)*pair.height>8388608)return false;
+    for(const auto& eye:target.eyes){if(!eye.orientation_valid||!eye.position_valid)return false;double norm=0;for(float q:eye.orientation){if(!std::isfinite(q))return false;norm+=double(q)*q;}if(std::abs(norm-1)>.01)return false;
+        for(float p:eye.position)if(!std::isfinite(p))return false;for(float angle:eye.fov)if(!std::isfinite(angle)||std::abs(angle)>=1.5f)return false;
+        if(eye.fov[0]>=-.0001f||eye.fov[1]<=.0001f||eye.fov[2]<=.0001f||eye.fov[3]>=-.0001f)return false;}
+    return true;
+}
+// No OpenXR call is performed here. Projection poses always describe the GPU
+// pair's production sample, not fresh poses pasted onto an older image.
+inline bool prepare_gpu_projection_layer(const GpuProjectionPair& pair,const GpuProjectionSwapchain& image,
+        XrSpace local,uint64_t current_origin,int64_t now,GpuProjectionData& out){
+    if(!local||!gpu_projection_pair_valid(pair,current_origin,now)||pair.device_generation!=image.device_generation||!image.chain||
+       !image.acquired_and_waited||!image.pair_copy_completed||image.array_size!=1||image.width!=2*pair.width||image.height!=pair.height)return false;
+    const auto& target=pair.target;
+    GpuProjectionData next;next.space=local;
+    for(unsigned eye=0;eye<2;++eye){const auto& pose=target.eyes[eye];auto& view=next.views[eye];
+        if(!pose.orientation_valid||!pose.position_valid)return false;double norm=0;for(float q:pose.orientation){if(!std::isfinite(q))return false;norm+=double(q)*q;}if(std::abs(norm-1)>.01)return false;
+        for(float p:pose.position)if(!std::isfinite(p))return false;
+        for(float angle:pose.fov)if(!std::isfinite(angle)||std::abs(angle)>=1.5f)return false;
+        if(pose.fov[0]>=-.0001f||pose.fov[1]<=.0001f||pose.fov[2]<=.0001f||pose.fov[3]>=-.0001f)return false;
+        const float inv=float(1/std::sqrt(norm));view.pose.orientation={pose.orientation[0]*inv,pose.orientation[1]*inv,pose.orientation[2]*inv,pose.orientation[3]*inv};
+        view.pose.position={pose.position[0],pose.position[1],pose.position[2]};view.fov={pose.fov[0],pose.fov[1],pose.fov[2],pose.fov[3]};
+        view.subImage.swapchain=image.chain;view.subImage.imageArrayIndex=0;view.subImage.imageRect.offset={int32_t(eye*pair.width),0};view.subImage.imageRect.extent={int32_t(pair.width),int32_t(pair.height)};
+    }
+    out=next;return true;
+}
+}
