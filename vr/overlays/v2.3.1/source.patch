+        if(matrix_color)for(auto field:std::initializer_list<std::pair<unsigned,float>>{{56,.05f},{57,1000.f},{64,999.95f},{72,32.f},{73,32.f},{74,reject_color?0.f:1.f/32},{75,1.f/32}})
