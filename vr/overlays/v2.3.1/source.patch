+    check(!verify_xr_native_eye_readback(patch,nullptr,gpu.size()).complete&&!verify_xr_native_eye_readback(patch,gpu.data(),gpu.size()-1).complete,"incomplete readbacks rejected");
+    auto bad=tag;bad.game_present=8;auto saved=patch;
+    check(!prepare_xr_native_eye_patch(bad,source.data(),source.size(),source.size(),packet,patch)&&patch.eye_prefixes==saved.eye_prefixes&&patch.source.recording==saved.source.recording,"wrong present rejected atomically");
+    bad=tag;bad.nvn_submit=0;check(!prepare_xr_native_eye_patch(bad,source.data(),source.size(),source.size(),packet,patch),"unowned submit rejected");
+    auto bad_packet=packet;bad_packet.tracking.predicted_display_time++;
+    check(!prepare_xr_native_eye_patch(tag,source.data(),source.size(),source.size(),bad_packet,patch),"tracking sample cannot be relabelled");
+    XrNativeEyePatch alias{};static_assert(sizeof(alias)>=0x230);std::memcpy(&alias,source.data(),0xe0);
