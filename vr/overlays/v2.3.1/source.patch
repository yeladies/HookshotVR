index 0000000000000000000000000000000000000000..92d080b20ea396b46bdaffa2ae00bbf46f530f5b
--- /dev/null
+++ b/gpu/vk/vk_xr_shader_uniform_audit.cpp
@@ -0,0 +1,134 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "xr_shader_uniform_audit.h"
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <iomanip>
+#include <map>
+#include <mutex>
+#include <set>
+#include <sstream>
+namespace mkwvk {
+namespace {
+struct Module {uint64_t digest=0;size_t words=0;bool written=false;};
+struct State {std::mutex mutex;std::map<uint64_t,Module> modules;std::set<uint64_t> digests,programs;uint64_t bytes=0,metadata_bytes=0;};
+// Process lifetime, matching renderer workers; no CRT teardown of a mutex they may still reach.
+State& state(){static auto* value=new State;return *value;}
+const char* directory(){static const char* path=std::getenv("HOOKSHOT_VR_SHADER_UNIFORM_AUDIT_DIR");return path;}
+std::string name(uint64_t digest){std::ostringstream s;s<<std::hex<<std::setw(16)<<std::setfill('0')<<digest;return s.str();}
+// Keep the existing byte budget for the stage family requested by this audit.
+// Entry-point models come from SPIR-V; unsupported/mixed or malformed modules fail closed.
+bool requested_scope(const uint32_t* words,size_t count,bool compute){
+    bool found=false;
+    for(size_t at=5;at<count;){
+        const uint32_t length=words[at]>>16,opcode=words[at]&65535;
+        if(!length||length>count-at)return false;
+        if(opcode==15){
+            if(length<4)return false;
+            bool is_compute=false;
+            switch(words[at+1]){
+                case 5:is_compute=true;break; // GLCompute
+                case 0:case 1:case 2:case 3:case 4: // graphics
+                case 5267:case 5268:case 5364:case 5365:break; // task/mesh NV/EXT
+                default:return false;
+            }
+            if(is_compute!=compute)return false;
+            found=true;
+        }
+        at+=length;
+    }
+    return found;
+}
+uint64_t digest_words(const uint32_t* words,size_t count){uint64_t hash=14695981039346656037ull;
+    for(size_t i=0;i<count;++i)for(unsigned byte=0;byte<4;++byte){hash^=(words[i]>>(byte*8))&255;hash*=1099511628211ull;}return hash;}
+}
+bool xr_shader_uniform_audit_enabled(){return directory()&&*directory();}
+bool xr_shader_uniform_audit_compute_only(){static const bool value=[]{const char* p=std::getenv("HOOKSHOT_VR_SHADER_UNIFORM_COMPUTE_ONLY");return p&&p[0]=='1';}();return value;}
+bool xr_shader_uniform_audit_module(uint64_t module,const uint32_t* words,size_t count){
+    if(!xr_shader_uniform_audit_enabled()||!module)return false;
+    auto& s=state();std::lock_guard lock(s.mutex);
+    // A reused handle must never retain the previous module's reviewed identity.
+    s.modules.erase(module);
+    if(!words||count<5||count>2*1024*1024||words[0]!=0x07230203||
+       !requested_scope(words,count,xr_shader_uniform_audit_compute_only())||s.modules.size()>=4096)return false;
+    const uint64_t digest=digest_words(words,count);bool written=s.digests.count(digest)!=0;
+    if(!written&&s.bytes+count*4<=64ull*1024*1024){
+        s.bytes+=count*4; // Reserve even on an I/O failure; partial files count toward the cap.
+        std::ofstream file(std::filesystem::u8path(directory())/(name(digest)+".spv"),std::ios::binary|std::ios::trunc);
+        if(file){file.write(reinterpret_cast<const char*>(words),std::streamsize(count*4));file.close();written=bool(file);
+            if(written){s.digests.insert(digest);}}
+    }
+    s.modules[module]={digest,count,written};return written;
+}
+bool xr_shader_uniform_audit_identity(uint64_t module,uint64_t& fingerprint,size_t& words){
+    if(!xr_shader_uniform_audit_enabled()||!module)return false;
+    auto& s=state();std::lock_guard lock(s.mutex);const auto found=s.modules.find(module);
+    if(found==s.modules.end()||!found->second.written)return false;
+    fingerprint=found->second.digest;words=found->second.words;return true;
+}
+bool xr_shader_uniform_audit_wants_program(uint64_t program){
+    if(!xr_shader_uniform_audit_enabled()||!program)return false;
+    auto& s=state();std::lock_guard lock(s.mutex);return s.programs.size()<64&&!s.programs.count(program);
+}
+bool xr_shader_uniform_audit_program(uint64_t program,const std::vector<ShaderUniformAuditBinding>& bindings,const std::vector<ShaderUniformAuditStage>& stages){
+    if(!xr_shader_uniform_audit_enabled()||!program)return false;
+    auto& s=state();std::lock_guard lock(s.mutex);
+    if(s.programs.count(program)||s.programs.size()>=64)return false;
+    s.programs.insert(program);
+    if((bindings.empty()&&stages.empty())||bindings.size()>128||stages.size()>8)return false;
+    uint32_t mask=0;
+    for(const auto& stage:stages){
+        if(!stage.module||stage.nvn_stage>=8||!stage.vk_stage||(stage.vk_stage&(stage.vk_stage-1))||stage.vk_stage>128||(mask&stage.vk_stage))return false;
+        mask|=stage.vk_stage;
+    }
+    if(!stages.empty())for(const auto& b:bindings){bool found=false;
+        for(const auto& stage:stages)if(stage.module==b.module&&stage.vk_stage==b.vk_stage&&stage.nvn_stage==b.nvn_stage)found=true;
+        if(!found)return false;
+    }
+    for(const auto& b:bindings){
+        auto valid=[&](const std::vector<uint32_t>& values,uint32_t size){
+            if(values.size()>64)return false;
+            for(auto offset:values)if(offset%16||offset>b.range_bytes||size>b.range_bytes-offset)return false;
+            return values.empty()||b.camera_candidates.eligible;
+        };
+        if(!valid(b.camera_candidates.view_offsets,48)||!valid(b.camera_candidates.projection_offsets,64)||
+           !valid(b.camera_candidates.vp_offsets,64))return false;
+    }
+    std::ostringstream file;
+    file<<"{\"schema\":1,\"program\":"<<program<<",\"stage_inventory_complete\":"<<(!stages.empty()?"true":"false")<<",\"stages\":[";bool first=true;
+    for(const auto& stage:stages){
+        if(!first)file<<',';first=false;
+        const auto found=s.modules.find(stage.module);const bool available=found!=s.modules.end()&&found->second.written;
+        file<<"{\"module\":";if(available)file<<'\"'<<name(found->second.digest)<<'\"';else file<<"null";
+        file<<",\"nvn_stage\":"<<stage.nvn_stage<<",\"vk_stage\":"<<stage.vk_stage
+            <<",\"uses_global_memory\":"<<(stage.uses_global_memory?"true":"false")
+            <<",\"stores_global_memory\":"<<(stage.stores_global_memory?"true":"false")
+            <<",\"writes_storage_buffers\":"<<(stage.writes_storage_buffers?"true":"false")
+            <<",\"writes_storage_images\":"<<(stage.writes_storage_images?"true":"false")
+            <<",\"writes_texel_buffers\":"<<(stage.writes_texel_buffers?"true":"false")<<'}';
+    }
+    file<<"],\"bindings\":[";first=true;
+    for(const auto& binding:bindings){
+        if(!first)file<<',';first=false;
+        const auto found=s.modules.find(binding.module);const bool available=found!=s.modules.end()&&found->second.written;
+        file<<"{\"module\":";
+        if(available)file<<'\"'<<name(found->second.digest)<<'\"';else file<<"null";
+        file<<",\"nvn_stage\":"<<binding.nvn_stage<<",\"vk_stage\":"<<binding.vk_stage<<",\"binding\":"<<binding.binding
+            <<",\"array_element\":"<<binding.array_element<<",\"bank\":"<<binding.bank<<",\"range_bytes\":"<<binding.range_bytes
+            <<",\"primary_camera_binding\":"<<(binding.primary_camera_binding?"true":"false")
+            <<",\"candidate_scan_eligible\":"<<(binding.camera_candidates.eligible?"true":"false")
+            <<",\"candidate_scan_truncated\":"<<(binding.camera_candidates.truncated?"true":"false")
+            <<",\"ambiguous_candidate_offsets\":"<<binding.camera_candidates.ambiguous_offsets;
+        auto offsets=[&](const char* field,const std::vector<uint32_t>& values){file<<",\""<<field<<"\":[";bool first=true;for(auto value:values){if(!first)file<<',';first=false;file<<value;}file<<']';};
+        offsets("candidate_view_offsets",binding.camera_candidates.view_offsets);
+        offsets("candidate_projection_offsets",binding.camera_candidates.projection_offsets);
+        offsets("candidate_vp_offsets",binding.camera_candidates.vp_offsets);file<<'}';
+    }
+    file<<"]}\n";const auto payload=file.str();
+    if(payload.size()>4*1024*1024-s.metadata_bytes)return false;
+    s.metadata_bytes+=payload.size(); // Reserve failed/partial writes too.
+    std::ofstream output(std::filesystem::u8path(directory())/"program-bindings.jsonl",std::ios::app);
+    if(!output)return false;output<<payload;output.close();
+    return bool(output);
+}
+}
diff --git a/gpu/vk/xr_baseline_attempt.h b/gpu/vk/xr_baseline_attempt.h
new file mode 100644
index 0000000000000000000000000000000000000000..1ae82993ae5a307311a4e819f22f14dd4db0982d
--- /dev/null
+++ b/gpu/vk/xr_baseline_attempt.h
@@ -0,0 +1,74 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <array>
+namespace mkwvk {
+// A skipped original draw must never lend its prepared resources to the next draw.
+// Values are native queue recording values, not frame numbers or CPU counters.
+class XrBaselineAttempt {
+public:
+    enum class Phase {Idle,Prepared,Finished,Abandoned,Retained,Retired};
+private:
+    Phase phase_=Phase::Idle;
+    uint64_t serial_=0,recording_=0,program_=0,device_=0,command_=0;
+public:
+    bool prepare(uint64_t serial,uint64_t recording,uint64_t program,uint64_t device,uint64_t command){
+        if(phase_!=Phase::Idle||!serial||!recording||!program||!device||!command)return false;
+        serial_=serial;recording_=recording;program_=program;device_=device;command_=command;
+        phase_=Phase::Prepared;return true;
+    }
+    bool finish(uint64_t serial,uint64_t recording,uint64_t program,uint64_t device,uint64_t command){
+        if(phase_!=Phase::Prepared||serial!=serial_||recording!=recording_||program!=program_||device!=device_||command!=command_)return false;
+        phase_=Phase::Finished;return true;
+    }
+    void next_draw(uint64_t serial){if(phase_==Phase::Prepared&&serial!=serial_)phase_=Phase::Abandoned;}
+    void abandon(){if(phase_==Phase::Prepared)phase_=Phase::Abandoned;}
+    bool retire(uint64_t device,uint64_t completed,bool completion_known){
+        if(phase_!=Phase::Finished&&phase_!=Phase::Abandoned)return false;
+        if(device!=device_||!completion_known){phase_=Phase::Retained;return false;}
+        if(completed<recording_)return false;
+        phase_=Phase::Retired;return true;
+    }
+    Phase phase()const{return phase_;}
+    uint64_t recording()const{return recording_;}
+    bool completed_draw()const{return phase_==Phase::Finished;}
+};
+struct XrBaselineComparison {
+    enum class Result {Invalid,Invisible,Match,Mismatch};
+    Result result=Result::Invalid;
+    bool matrix_probe_requested=false,matrix_probe_validated=false,matrix_source_unchanged=false;
+    bool depth_reference=false;
+    bool native_eye_requested=false,native_eye_source_prefix_matched=false,native_eye_gpu_tails_preserved=false,native_eye_raster_observed=false;
+    std::array<uint64_t,2> native_eye_changed_pixels{};uint64_t native_eye_pair_differences=0;
+    int64_t native_eye_game_present=-1;uint64_t native_eye_nvn_submit=0,native_eye_recording=0,native_eye_guest_camera=0,native_eye_writer_guest_camera=0;
+    uint64_t native_eye_tracking_sequence=0,native_eye_origin_generation=0;int64_t native_eye_predicted_display_time=0,native_eye_observed_ns=0;
+    bool shifted_draw_requested=false,shifted_draw_verified=false,view_shift_requested=false,view_color_requested=false;float view_shift_units=0;
+    std::array<double,3> shifted_centroid_x{},shifted_centroid_y{};std::array<uint64_t,3> shifted_changed_pixels{};
+    bool root_alias_requested=false,root_alias_verified=false,root_indirect_verified=false,root_indirect_draws_recorded=false,camera_payload_exported=false;
+    std::array<uint32_t,2> root_indirect_counts{};uint64_t root_alias_allocated_bytes=0;
+    std::array<uint64_t,2> root_alias_counts{},root_alias_uncovered{},root_alias_errors{};
+    uint64_t matrix_payload_bytes=0;
+    uint64_t changed_pixels=0;
+    std::array<uint64_t,2> mismatched_pixels{};
+};
+// Four tightly packed B10G11R11 frames: original before/after and private left/right.
+// Bitwise equality is intentional: this first experiment changes no camera data.
+inline XrBaselineComparison compare_xr_baseline(const void* bytes,size_t available,uint32_t width,uint32_t height){
+    XrBaselineComparison out;
+    if(!bytes||!width||!height||width>4096||height>4096)return out;
+    const uint64_t pixels=uint64_t(width)*height,frame=pixels*4;
+    if(available!=frame*4)return out;
+    const auto* data=static_cast<const unsigned char*>(bytes);
+    for(uint64_t pixel=0;pixel<pixels;++pixel){
+        const auto offset=pixel*4;
+        out.changed_pixels+=std::memcmp(data+offset,data+frame+offset,4)!=0;
+        for(unsigned eye=0;eye<2;++eye)out.mismatched_pixels[eye]+=std::memcmp(data+frame+offset,data+(eye+2)*frame+offset,4)!=0;
+    }
+    // A mismatch is never hidden by an unchanged original reference.
+    out.result=(out.mismatched_pixels[0]||out.mismatched_pixels[1])?XrBaselineComparison::Result::Mismatch:
+        out.changed_pixels?XrBaselineComparison::Result::Match:XrBaselineComparison::Result::Invisible;
+    return out;
+}
+}
