+struct XrBaselineRecorderInput {
+    uint64_t serial=0,recording=0,program=0;VkCommandBuffer command=VK_NULL_HANDLE;
+    VkPipelineLayout layout=VK_NULL_HANDLE;EyeImageSource color{},depth{};
