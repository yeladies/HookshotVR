diff --git a/gpu/vk/xr_depth_pair_tracking.h b/gpu/vk/xr_depth_pair_tracking.h
new file mode 100644
index 0000000000000000000000000000000000000000..2ab346d4f29a085055e9edc0719384e5b2917586
--- /dev/null
+++ b/gpu/vk/xr_depth_pair_tracking.h
@@ -0,0 +1,55 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include "xr_depth_pair_parameters.h"
+#include "xr_immersive_camera.h"
+namespace hookshot::vr {
+struct DepthPairLocatedEye {
+    std::array<float,4> orientation{0,0,0,1};std::array<float,3> position{};
+    std::array<float,4> fov{};bool orientation_valid=false,position_valid=false;
+};
+struct DepthPairTrackingTarget {
+    std::array<DepthPairLocatedEye,2> eyes;uint64_t origin=0,serial=0;int64_t observed_ns=0;
+};
+// Expand actual rendered eye frusta and their production metadata together.
+// Reprojection can then sample a guard band instead of exposing a hard boundary.
+inline bool expand_depth_pair_fovs(DepthPairTrackingTarget& target,float scale){
+    if(!std::isfinite(scale)||scale<1||scale>1.25f)return false;
+    auto expanded=target;
+    for(auto& eye:expanded.eyes){const auto& f=eye.fov;
+        if(f[0]>=0||f[1]<=0||f[2]<=0||f[3]>=0)return false;
+        for(float& angle:eye.fov){if(!std::isfinite(angle)||std::abs(angle)>=1.45f)return false;const float value=std::atan(std::tan(angle)*scale);if(!std::isfinite(value)||std::abs(value)>=1.5f)return false;if(scale!=1)angle=value;}
+    }
+    target=expanded;return true;
+}
+namespace depth_tracking_detail {
+inline bool rotation(const float* q,std::array<double,9>& r){
+    double n=0;for(unsigned i=0;i<4;++i){if(!std::isfinite(q[i]))return false;n+=double(q[i])*q[i];}if(std::abs(n-1)>.01)return false;
+    const double inv=1/std::sqrt(n),x=q[0]*inv,y=q[1]*inv,z=q[2]*inv,w=q[3]*inv;
+    r={1-2*(y*y+z*z),2*(x*y-z*w),2*(x*z+y*w),2*(x*y+z*w),1-2*(x*x+z*z),2*(y*z-x*w),2*(x*z-y*w),2*(y*z+x*w),1-2*(x*x+y*y)};return true;
+}
+}
+// Pose metadata only. A source lease/fence owner must independently establish
+// immutable GPU storage, device/queue identity and lifetime through submission.
+// Coordinates match the existing mono ImmersiveCamera: RH, -Z forward, one
+// provisional source unit per metre. The anchor/base game camera cancels.
+inline bool prepare_tracked_depth_pair_parameters(const DepthPairSource& source,const mkwvk::ImmersiveTag& captured,
+        const DepthPairTrackingTarget& target,int64_t now,uint32_t width,uint32_t height,std::array<DepthPairParameters,2>& out){
+    if(now<=0||!source.state||!source.generation||!captured.valid||captured.menu||captured.temporal_stereo||!captured.generation||
+       source.origin!=captured.generation||captured.observed_ns<=0||source.capture_pose!=uint64_t(captured.observed_ns)||
+       now<captured.observed_ns||now-captured.observed_ns>250000000||target.origin!=captured.generation||!target.serial||
+       target.observed_ns<captured.observed_ns||now<target.observed_ns||now-target.observed_ns>50000000)return false;
+    std::array<double,9> capture_rotation;if(!depth_tracking_detail::rotation(captured.orientation,capture_rotation))return false;
+    for(float x:captured.position)if(!std::isfinite(x))return false;
+    std::array<DepthPairParameters,2> next{};
+    for(unsigned eye=0;eye<2;++eye){const auto& located=target.eyes[eye];auto& p=next[eye];std::array<double,9> rotation;
+        if(!located.orientation_valid||!located.position_valid||!depth_tracking_detail::rotation(located.orientation.data(),rotation))return false;
+        double distance=0;for(unsigned k=0;k<3;++k){if(!std::isfinite(located.position[k]))return false;const double d=double(located.position[k])-captured.position[k];distance+=d*d;}if(distance>1)return false;
+        for(unsigned r=0;r<3;++r){for(unsigned c=0;c<3;++c){double value=0;for(unsigned k=0;k<3;++k)value+=capture_rotation[3*k+r]*rotation[3*k+c];p.source_from_eye[4*r+c]=float(value);}
+            double translation=0;for(unsigned k=0;k<3;++k)translation+=capture_rotation[3*k+r]*(double(located.position[k])-captured.position[k]);p.source_from_eye[4*r+3]=float(translation);}
+        for(unsigned i=0;i<4;++i){const float angle=located.fov[i];if(!std::isfinite(angle)||std::abs(angle)>=1.5f)return false;p.eye_tangents[i]=std::tan(angle);}
+        p.projection=source.projection;p.optical={source.optical_center[0],source.optical_center[1],25000,.85f};p.dimensions={source.width,source.height,width,height};p.settings={source.format,8,0,0};
+        if(!depth_pair_parameters_valid(p))return false;
+    }
+    out=next;return true;
+}
+}
diff --git a/gpu/vk/xr_descriptor_snapshot.h b/gpu/vk/xr_descriptor_snapshot.h
new file mode 100644
index 0000000000000000000000000000000000000000..04e6c4e2c9d59442fd32acbfb7f1c9815a819989
--- /dev/null
+++ b/gpu/vk/xr_descriptor_snapshot.h
@@ -0,0 +1,65 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <vulkan/vulkan.h>
+#include <vector>
+namespace mkwvk {
+// Owning, move-only snapshot of a bounded full pushed set. Raw data pointers always
+// refer to this snapshot's own vectors; no pointer into a mutable renderer writer.
+class XrDescriptorSnapshot {
+    std::vector<VkWriteDescriptorSet> writes_;
+    std::vector<VkDescriptorBufferInfo> buffers_;
+    std::vector<VkDescriptorImageInfo> images_;
+    std::vector<VkBufferView> views_;
+    static int kind(VkDescriptorType type){
+        switch(type){
+        case VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER:case VK_DESCRIPTOR_TYPE_STORAGE_BUFFER:return 1;
+        case VK_DESCRIPTOR_TYPE_SAMPLER:case VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER:case VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE:case VK_DESCRIPTOR_TYPE_STORAGE_IMAGE:return 2;
+        case VK_DESCRIPTOR_TYPE_UNIFORM_TEXEL_BUFFER:case VK_DESCRIPTOR_TYPE_STORAGE_TEXEL_BUFFER:return 3;
+        default:return 0;
+        }
+    }
+public:
+    XrDescriptorSnapshot()=default;
+    XrDescriptorSnapshot(const XrDescriptorSnapshot&)=delete;XrDescriptorSnapshot& operator=(const XrDescriptorSnapshot&)=delete;
+    XrDescriptorSnapshot(XrDescriptorSnapshot&&)=default;XrDescriptorSnapshot& operator=(XrDescriptorSnapshot&&)=default;
+    bool capture(const std::vector<VkWriteDescriptorSet>& source){
+        if(source.empty()||source.size()>32)return false;size_t total=0,nb=0,ni=0,nv=0;
+        for(size_t index=0;index<source.size();++index){const auto& w=source[index];const int k=kind(w.descriptorType);
+            if(w.sType!=VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET||w.pNext||w.dstArrayElement||!w.descriptorCount||w.descriptorCount>32-total||!k)return false;
+            for(size_t previous=0;previous<index;++previous)if(source[previous].dstBinding==w.dstBinding)return false;
+            if((k==1&&!w.pBufferInfo)||(k==2&&!w.pImageInfo)||(k==3&&!w.pTexelBufferView))return false;
+            total+=w.descriptorCount;if(k==1)nb+=w.descriptorCount;if(k==2)ni+=w.descriptorCount;if(k==3)nv+=w.descriptorCount;
+        }
+        XrDescriptorSnapshot next;next.writes_.reserve(source.size());next.buffers_.reserve(nb);next.images_.reserve(ni);next.views_.reserve(nv);
+        for(auto w:source){const int k=kind(w.descriptorType);w.dstSet=VK_NULL_HANDLE;
+            if(k==1){const auto first=next.buffers_.size();next.buffers_.insert(next.buffers_.end(),w.pBufferInfo,w.pBufferInfo+w.descriptorCount);w.pBufferInfo=next.buffers_.data()+first;}
+            if(k==2){const auto first=next.images_.size();next.images_.insert(next.images_.end(),w.pImageInfo,w.pImageInfo+w.descriptorCount);w.pImageInfo=next.images_.data()+first;}
+            if(k==3){const auto first=next.views_.size();next.views_.insert(next.views_.end(),w.pTexelBufferView,w.pTexelBufferView+w.descriptorCount);w.pTexelBufferView=next.views_.data()+first;}
+            next.writes_.push_back(w);
+        }
+        *this=std::move(next);return true;
+    }
+    bool set_uniform(uint32_t binding,uint32_t element,const VkDescriptorBufferInfo& value){
+        if(!value.buffer||!value.range||value.range==VK_WHOLE_SIZE)return false;
+        for(const auto& w:writes_)if(w.dstBinding==binding&&w.descriptorType==VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER&&element<w.descriptorCount){
+            buffers_[size_t(w.pBufferInfo-buffers_.data())+element]=value;return true;
+        }
+        return false;
+    }
+    bool matches(const std::vector<VkWriteDescriptorSet>& source)const{
+        if(source.size()!=writes_.size())return false;
+        for(size_t i=0;i<source.size();++i){const auto& a=writes_[i];const auto& b=source[i];
+            if(b.sType!=VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET||b.pNext||a.dstBinding!=b.dstBinding||a.dstArrayElement!=b.dstArrayElement||a.descriptorCount!=b.descriptorCount||a.descriptorType!=b.descriptorType)return false;
+            const int k=kind(a.descriptorType);
+            if((k==1&&!b.pBufferInfo)||(k==2&&!b.pImageInfo)||(k==3&&!b.pTexelBufferView))return false;
+            for(uint32_t item=0;item<a.descriptorCount;++item){
+                if(k==1){const auto& x=a.pBufferInfo[item];const auto& y=b.pBufferInfo[item];if(x.buffer!=y.buffer||x.offset!=y.offset||x.range!=y.range)return false;}
+                if(k==2){const auto& x=a.pImageInfo[item];const auto& y=b.pImageInfo[item];if(x.sampler!=y.sampler||x.imageView!=y.imageView||x.imageLayout!=y.imageLayout)return false;}
+                if(k==3&&a.pTexelBufferView[item]!=b.pTexelBufferView[item])return false;
+            }
+        }
+        return true;
+    }
+    const std::vector<VkWriteDescriptorSet>& writes()const{return writes_;}
+};
+}
diff --git a/gpu/vk/xr_eye_image_factory.h b/gpu/vk/xr_eye_image_factory.h
new file mode 100644
index 0000000000000000000000000000000000000000..8e00ed4d6692722f1ca83155d878415abd601e09
--- /dev/null
+++ b/gpu/vk/xr_eye_image_factory.h
@@ -0,0 +1,131 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <vulkan/vulkan.h>
+#include <array>
+#include <algorithm>
+#include <cstdint>
+namespace mkwvk {
+struct EyeImageSource {
+    VkImage image=VK_NULL_HANDLE;uint64_t identity=0;
+    VkFormat format=VK_FORMAT_UNDEFINED;VkImageAspectFlags aspect=0;
+    VkImageCreateFlags flags=0;VkImageUsageFlags usage=0;
+    uint32_t width=0,height=0,levels=0,layers=0;
+    bool sparse=false;VkSampleCountFlagBits samples=VK_SAMPLE_COUNT_1_BIT;
+    VkImageType type=VK_IMAGE_TYPE_2D;
+};
+struct EyeImageViewPair {std::array<VkImageView,2> eyes{};};
+struct EyeImageFactoryApi {
+    VkDevice device=VK_NULL_HANDLE;
+    PFN_vkCreateImage create_raw=nullptr;PFN_vkDestroyImage destroy_raw=nullptr;
+    PFN_vkGetImageMemoryRequirements requirements=nullptr;
+    bool (*allocate_strict)(const VkImageCreateInfo&,VkImage&,uintptr_t&)=nullptr;
+    void (*release)(VkImage,uintptr_t)=nullptr;uint64_t (*allocation_bytes)(uintptr_t)=nullptr;
+    PFN_vkCmdPipelineBarrier2 barrier=nullptr;PFN_vkCmdCopyImage copy=nullptr;
+    PFN_vkCreateImageView create_view=nullptr;PFN_vkDestroyImageView destroy_view=nullptr;
+    bool valid()const{return device&&create_raw&&destroy_raw&&requirements&&allocate_strict&&release&&allocation_bytes&&barrier&&copy&&create_view&&destroy_view;}
+};
+inline VkImageAspectFlags eye_format_aspects(VkFormat format) {
+    switch(format){
+    case VK_FORMAT_D16_UNORM:case VK_FORMAT_X8_D24_UNORM_PACK32:case VK_FORMAT_D32_SFLOAT:return VK_IMAGE_ASPECT_DEPTH_BIT;
+    case VK_FORMAT_S8_UINT:return VK_IMAGE_ASPECT_STENCIL_BIT;
+    case VK_FORMAT_D16_UNORM_S8_UINT:case VK_FORMAT_D24_UNORM_S8_UINT:case VK_FORMAT_D32_SFLOAT_S8_UINT:return VK_IMAGE_ASPECT_DEPTH_BIT|VK_IMAGE_ASPECT_STENCIL_BIT;
+    default:return format>VK_FORMAT_UNDEFINED&&format<=VK_FORMAT_ASTC_12x12_SRGB_BLOCK?VK_IMAGE_ASPECT_COLOR_BIT:0;
+    }
+}
+// Strict, separate native images; never a shallow Texture copy or a guest registration.
+// Exact-format 2D/array views only; no descriptor remapping. The caller owns device/allocator lifetime and
+// must retire only using the actual completed timeline of the queue that used these images.
+class EyeImageClonePair {
+    EyeImageFactoryApi api_{};EyeImageSource source_{};
+    std::array<VkImage,2> images_{};std::array<uintptr_t,2> allocations_{};
+    std::array<std::array<VkImageView,2>,32> views_{};uint32_t view_count_=0;
+    uint64_t bytes_=0,last_use_=0;bool ready_=false,recorded_=false;
+    void release() {
+        for(uint32_t i=0;i<view_count_;++i)for(auto view:views_[i])if(view)api_.destroy_view(api_.device,view,nullptr);
+        view_count_=0;
+        for(unsigned i=0;i<2;++i){if(images_[i])api_.release(images_[i],allocations_[i]);images_[i]=VK_NULL_HANDLE;allocations_[i]=0;}
+        bytes_=0;ready_=false;recorded_=false;
+    }
+public:
+    EyeImageClonePair()=default;EyeImageClonePair(const EyeImageClonePair&)=delete;EyeImageClonePair& operator=(const EyeImageClonePair&)=delete;
+    ~EyeImageClonePair(){if(!last_use_)release();} // Unretired submitted storage is retained, never freed speculatively.
+    bool create(const EyeImageSource& source,const EyeImageFactoryApi& api,uint64_t budget) {
+        const VkImageCreateFlags supported=VK_IMAGE_CREATE_MUTABLE_FORMAT_BIT|VK_IMAGE_CREATE_CUBE_COMPATIBLE_BIT|
+            VK_IMAGE_CREATE_BLOCK_TEXEL_VIEW_COMPATIBLE_BIT|VK_IMAGE_CREATE_EXTENDED_USAGE_BIT|VK_IMAGE_CREATE_ALIAS_BIT;
+        const VkImageUsageFlags transfer=VK_IMAGE_USAGE_TRANSFER_SRC_BIT|VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+        if(ready_||last_use_||!api.valid()||!source.image||!source.identity||source.sparse||source.type!=VK_IMAGE_TYPE_2D||
+           source.samples!=VK_SAMPLE_COUNT_1_BIT||!source.width||!source.height||source.width>16384||source.height>16384||
+           !source.layers||source.layers>2048||!source.levels||source.levels>32||!source.aspect||
+           source.aspect!=eye_format_aspects(source.format)||(source.flags&~supported)||
+           (source.usage&transfer)!=transfer||!budget||budget>512ull*1024*1024)return false;
+        uint32_t levels=1;for(uint32_t extent=std::max(source.width,source.height);extent>1;extent>>=1)++levels;
+        if(source.levels>levels||((source.flags&VK_IMAGE_CREATE_CUBE_COMPATIBLE_BIT)&&
+           (source.width!=source.height||source.layers<6)))return false;
+        api_=api;source_=source;
+        VkImageCreateInfo ci{VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};ci.flags=source.flags;ci.imageType=source.type;ci.format=source.format;
+        ci.extent={source.width,source.height,1};ci.mipLevels=source.levels;ci.arrayLayers=source.layers;ci.samples=source.samples;
+        ci.tiling=VK_IMAGE_TILING_OPTIMAL;ci.usage=source.usage;ci.sharingMode=VK_SHARING_MODE_EXCLUSIVE;ci.initialLayout=VK_IMAGE_LAYOUT_UNDEFINED;
+        // Query the driver's real requirements before allocating either eye.
+        VkImage probe=VK_NULL_HANDLE;if(api_.create_raw(api_.device,&ci,nullptr,&probe)!=VK_SUCCESS)return false;
+        VkMemoryRequirements requirements{};api_.requirements(api_.device,probe,&requirements);api_.destroy_raw(api_.device,probe,nullptr);
+        if(!requirements.size||requirements.size>budget/2)return false;
+        for(unsigned i=0;i<2;++i){
+            if(!api_.allocate_strict(ci,images_[i],allocations_[i])){release();return false;}
+            const auto size=api_.allocation_bytes(allocations_[i]);
+            if(!size||size!=requirements.size||size>budget-bytes_){release();return false;}bytes_+=size;
+        }
+        ready_=true;return true;
+    }
+    bool create_view_pair(const VkImageViewCreateInfo& original,EyeImageViewPair& out) {
+        const auto& range=original.subresourceRange;
+        if(!ready_||view_count_>=views_.size()||original.sType!=VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO||original.pNext||original.flags||
+           original.image!=source_.image||original.format!=source_.format||
+           (original.viewType!=VK_IMAGE_VIEW_TYPE_2D&&original.viewType!=VK_IMAGE_VIEW_TYPE_2D_ARRAY)||
+           !range.aspectMask||(range.aspectMask&~source_.aspect)||range.baseMipLevel>=source_.levels||range.baseArrayLayer>=source_.layers)return false;
+        const uint32_t levels=range.levelCount==VK_REMAINING_MIP_LEVELS?source_.levels-range.baseMipLevel:range.levelCount;
+        const uint32_t layers=range.layerCount==VK_REMAINING_ARRAY_LAYERS?source_.layers-range.baseArrayLayer:range.layerCount;
+        if(!levels||levels>source_.levels-range.baseMipLevel||!layers||layers>source_.layers-range.baseArrayLayer||
+           (original.viewType==VK_IMAGE_VIEW_TYPE_2D&&layers!=1))return false;
+        for(auto swizzle:{original.components.r,original.components.g,original.components.b,original.components.a})
+            if(swizzle<VK_COMPONENT_SWIZZLE_IDENTITY||swizzle>VK_COMPONENT_SWIZZLE_A)return false;
+        std::array<VkImageView,2> created{};
+        for(unsigned eye=0;eye<2;++eye){auto ci=original;ci.image=images_[eye];VkImageView candidate=VK_NULL_HANDLE;
+            if(api_.create_view(api_.device,&ci,nullptr,&candidate)!=VK_SUCCESS){
+                for(unsigned before=0;before<eye;++before)api_.destroy_view(api_.device,created[before],nullptr);
+                return false;
+            }
+            created[eye]=candidate;
+        }
+        views_[view_count_++]=created;out.eyes=created;return true;
+    }
+    uint32_t owned_view_count()const{return view_count_*2;}
+    bool record_initial_copy(VkCommandBuffer command,uint64_t value) {
+        if(!ready_||recorded_||!command||!value)return false;
+        std::array<VkImageMemoryBarrier2,3> barriers{};
+        for(unsigned i=0;i<3;++i){auto& b=barriers[i];b.sType=VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER_2;
+            b.srcStageMask=i?VK_PIPELINE_STAGE_2_NONE:VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT;
+            b.srcAccessMask=i?0:VK_ACCESS_2_MEMORY_WRITE_BIT;b.dstStageMask=VK_PIPELINE_STAGE_2_COPY_BIT;
+            b.dstAccessMask=i?VK_ACCESS_2_TRANSFER_WRITE_BIT:VK_ACCESS_2_TRANSFER_READ_BIT;
+            b.oldLayout=i?VK_IMAGE_LAYOUT_UNDEFINED:VK_IMAGE_LAYOUT_GENERAL;b.newLayout=VK_IMAGE_LAYOUT_GENERAL;
+            b.srcQueueFamilyIndex=b.dstQueueFamilyIndex=VK_QUEUE_FAMILY_IGNORED;b.image=i?images_[i-1]:source_.image;
+            b.subresourceRange={source_.aspect,0,source_.levels,0,source_.layers};}
+        VkDependencyInfo dependency{VK_STRUCTURE_TYPE_DEPENDENCY_INFO};dependency.imageMemoryBarrierCount=3;dependency.pImageMemoryBarriers=barriers.data();
+        std::array<VkImageCopy,64> regions{};uint32_t count=0;
+        for(auto aspect:{VK_IMAGE_ASPECT_COLOR_BIT,VK_IMAGE_ASPECT_DEPTH_BIT,VK_IMAGE_ASPECT_STENCIL_BIT})if(source_.aspect&aspect)
+            for(uint32_t level=0;level<source_.levels;++level){auto& r=regions[count++];r.srcSubresource=r.dstSubresource={VkImageAspectFlags(aspect),level,0,source_.layers};
+                r.extent={std::max(1u,source_.width>>level),std::max(1u,source_.height>>level),1};}
+        last_use_=value;recorded_=true;
+        api_.barrier(command,&dependency);
+        for(auto image:images_)api_.copy(command,source_.image,VK_IMAGE_LAYOUT_GENERAL,image,VK_IMAGE_LAYOUT_GENERAL,count,regions.data());
+        VkMemoryBarrier2 after{VK_STRUCTURE_TYPE_MEMORY_BARRIER_2};after.srcStageMask=VK_PIPELINE_STAGE_2_COPY_BIT;
+        after.srcAccessMask=VK_ACCESS_2_TRANSFER_READ_BIT|VK_ACCESS_2_TRANSFER_WRITE_BIT;
+        after.dstStageMask=VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT;after.dstAccessMask=VK_ACCESS_2_MEMORY_READ_BIT|VK_ACCESS_2_MEMORY_WRITE_BIT;
+        dependency.imageMemoryBarrierCount=0;dependency.pImageMemoryBarriers=nullptr;dependency.memoryBarrierCount=1;dependency.pMemoryBarriers=&after;
+        api_.barrier(command,&dependency);return true;
+    }
+    bool mark_used(uint64_t value){if(!ready_||!recorded_||!value)return false;last_use_=std::max(last_use_,value);return true;}
+    bool retire(uint64_t completed){if(last_use_&&completed<last_use_)return false;release();last_use_=0;return true;}
+    VkImage eye(unsigned index)const{return ready_&&index<2?images_[index]:VK_NULL_HANDLE;}
+    uint64_t allocated_bytes()const{return bytes_;}
+};
+}
