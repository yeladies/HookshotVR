+            <<",\"dependent\":"<<(record.dependent?"true":"false")<<",\"opaque_buffers\":"<<(record.work.opaque_buffers?"true":"false")
+            <<",\"width\":"<<record.work.width<<",\"height\":"<<record.work.height<<",\"reads\":[";
