+    std::vector<uint32_t> mixed(std::begin(words),std::end(words));mixed.insert(mixed.end(),std::begin(compute)+5,std::end(compute));
+    check(!xr_shader_uniform_audit_module(40,mixed.data(),mixed.size()),"mixed compute/graphics module is not a scoped proof");
+    uint64_t previous=0;size_t previous_words=0;
+    check(!xr_shader_uniform_audit_module(2,compute,10)&&!xr_shader_uniform_audit_identity(2,previous,previous_words),"filtered handle reuse invalidates old graphics evidence");
+    check(xr_shader_uniform_audit_module(2,fragment,10),"recaptured graphics replacement has its own identity");
