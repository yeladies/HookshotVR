--- /dev/null
+++ b/vr/src/eye_resource_smoke.cpp
@@ -0,0 +1,327 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Explicit opt-in native GPU smoke. No game, XR runtime, window or display changes.
+#define VK_NO_PROTOTYPES
+#include "eye_vulkan_resources.h"
+#include "eye_uniform_copy.h"
+#include "camera_math.h"
+#include "eye_address_copy_spv.h"
+#include "../../gpu/vk/xr_eye_matrix_patch_spv.h"
+#include "eye_page_patches.h"
+#include "eye_buffer_descriptors.h"
+#include "same_state_gpu_copy.h"
+#include "eye_root_alias_patch.h"
+#include "eye_root_alias_patch_spv.h"
+#include <memory>
+#include <cstring>
+#include <iostream>
+#include <stdexcept>
+#include <vector>
+#ifdef _WIN32
+#define WIN32_LEAN_AND_MEAN
+#define NOMINMAX
+#include <windows.h>
+#else
+#include <dlfcn.h>
+#endif
+using namespace hookshot::vr;
+#include "gpu_smoke_context.h"
+using namespace hookshot::vr::smoke;
+int main(int argc,char** argv){
+    const bool reject_root_payload=argc==3&&!std::strcmp(argv[2],"--gpu-root-alias-payload-rejection");
+    const bool reject_root_alignment=argc==3&&!std::strcmp(argv[2],"--gpu-root-alias-misaligned-rejection");
+    const bool reject_root_partial=reject_root_alignment||(argc==3&&!std::strcmp(argv[2],"--gpu-root-alias-partial-rejection"));
+    const bool gpu_root_alias=reject_root_payload||reject_root_partial||(argc==3&&!std::strcmp(argv[2],"--gpu-root-alias-patch"));
+    const bool gpu_eye_copy=argc==3&&!std::strcmp(argv[2],"--same-state-copy");
+    const bool reject_ubo=argc==3&&!std::strcmp(argv[2],"--expect-ubo-rejection");
+    const bool reject_ssbo=argc==3&&!std::strcmp(argv[2],"--expect-ssbo-rejection");
+    const bool reject_matrix_shift=argc==3&&!std::strcmp(argv[2],"--matrix-patch-reject-shift");
+    const bool reject_matrix_view=argc==3&&!std::strcmp(argv[2],"--matrix-patch-reject-view");
+    const bool reject_color=argc==3&&!std::strcmp(argv[2],"--matrix-patch-color-invalid-viewport");
+    const bool matrix_color=reject_color||(argc==3&&!std::strcmp(argv[2],"--matrix-patch-color-view"));
+    const bool matrix_raw=matrix_color||(argc==3&&!std::strcmp(argv[2],"--matrix-patch-view-diagnostic"));
+    const bool matrix_lens=argc==3&&!std::strcmp(argv[2],"--matrix-patch-lens");
+    const bool matrix_patch=matrix_raw||matrix_lens||(argc==3&&!std::strcmp(argv[2],"--matrix-patch"))||reject_matrix_shift||reject_matrix_view||reject_color;
+    if(argc<2||argc>3||std::strcmp(argv[1],"--run")||(argc==3&&!reject_ubo&&!reject_ssbo&&!matrix_patch&&!gpu_eye_copy&&!gpu_root_alias)){
+        std::cerr<<"Explicit native GPU opt-in: --run [--gpu-root-alias-payload-rejection|--gpu-root-alias-misaligned-rejection|--gpu-root-alias-patch|--gpu-root-alias-partial-rejection|--matrix-patch-color-view|--matrix-patch-color-invalid-viewport|--matrix-patch-view-diagnostic|--same-state-copy|--expect-ubo-rejection|--expect-ssbo-rejection|--matrix-patch|--matrix-patch-lens|--matrix-patch-reject-shift|--matrix-patch-reject-view]\n";return 2;
+    }
+    const bool expect_rejection=reject_ubo||reject_ssbo;
+    try {
+        Context c;const auto gpu=initialize_smoke(c);
+        const auto physical=gpu.physical;const auto family=gpu.family;const auto props=gpu.props;const auto memory=gpu.memory;const auto api=gpu.api;
+        // Entirely authored camera payload: no game data or measured world calibration.
+        std::vector<std::byte> original(4096);
+        for(size_t i=0;i<original.size();++i)original[i]=std::byte((i*37)%256);
+        float base[0xe0/4]{};for(int i=0;i<3;++i)base[4*i+i]=1;
+        ProjectionMatrix projection{};require(eye_projection({-.7,.8,.9,-.6},.05,1000,ClipDepth::MinusOneToOne,DepthOrder::Forward,false,projection),"authored projection");
+        for(int i=0;i<16;++i)base[0x70/4+i]=float(projection[i]);
+        if(matrix_patch){CameraView view;TrackingOrigin origin{};origin.yaw_radians=.3;
+            XrPosef pose{{float(std::sin(.1)),0,0,float(std::cos(.1))},{1,2,3}};
+            require(tracked_camera_view(origin,pose,3,view),"authored pitched source camera");
+            for(int r=0;r<3;++r)for(int col=0;col<4;++col)base[4*r+col]=float(view.rows[r][col]);}
