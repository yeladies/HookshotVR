diff --git a/gpu/vk/xr_baseline_selection.h b/gpu/vk/xr_baseline_selection.h
new file mode 100644
index 0000000000000000000000000000000000000000..f7b5d892af7f4e798f8fee535f62c632cabfdec0
--- /dev/null
+++ b/gpu/vk/xr_baseline_selection.h
@@ -0,0 +1,46 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <charconv>
+#include <cstdint>
+#include <sstream>
+#include <string>
+#include <string_view>
+#include <vector>
+namespace mkwvk {
+struct XrBaselineStage {uint32_t nvn_stage=0,vk_stage=0;uint64_t fingerprint=0,words=0;};
+struct XrBaselineProgram {uint64_t program=0;std::vector<XrBaselineStage> stages;};
+struct XrBaselineSelection {std::string nonce,source;std::vector<XrBaselineProgram> programs;};
+inline bool xr_lower_hex(std::string_view value,size_t count){
+    if(value.size()!=count)return false;
+    for(char c:value)if(!((c>='0'&&c<='9')||(c>='a'&&c<='f')))return false;return true;
+}
+inline bool xr_selection_number(std::istringstream& input,uint64_t& out,bool hex=false){
+    std::string value;if(!(input>>value)||value.empty()||value.size()>(hex?16:10))return false;
+    if(hex){if(!xr_lower_hex(value,16))return false;}
+    else for(char c:value)if(c<'0'||c>'9')return false;
+    uint64_t candidate=0;const auto result=std::from_chars(value.data(),value.data()+value.size(),candidate,hex?16:10);
+    if(result.ec!=std::errc{}||result.ptr!=value.data()+value.size())return false;out=candidate;return true;
+}
+// Selection scopes a baseline-only experiment. It is not permission for camera/scene
+// replay; live state and module identities must still be checked at the actual draw.
+inline bool parse_xr_baseline_selection(std::string_view text,std::string_view nonce,std::string_view source,XrBaselineSelection& out,bool lens_shift=false,bool view_shift=false,bool view_color=false,bool native_eye=false){
+    if(native_eye&&(lens_shift||view_shift||view_color))return false;
+    if(view_color&&!view_shift)return false;
+    if(text.size()>8192||!xr_lower_hex(nonce,32)||!xr_lower_hex(source,8))return false;
+    std::istringstream input{std::string(text)};std::string magic;XrBaselineSelection next;
+    if(!(input>>magic>>next.nonce>>next.source)||magic!=(native_eye?"HSVR_NATIVE_EYE_DRAW_V1":view_color?"HSVR_VIEW_COLOR_DRAW_V1":(view_shift?"HSVR_VIEW_SHIFT_DRAW_V1":(lens_shift?"HSVR_LENS_SHIFT_DRAW_V1":"HSVR_BASELINE_DRAW_V1")))||next.nonce!=nonce||next.source!=source)return false;
+    uint64_t count=0;if(!xr_selection_number(input,count)||!count||count>32)return false;
+    for(uint64_t i=0;i<count;++i){XrBaselineProgram program;uint64_t stages=0;
+        if(!xr_selection_number(input,program.program,true)||!program.program||!xr_selection_number(input,stages)||stages!=2)return false;
+        for(const auto& previous:next.programs)if(previous.program==program.program)return false;
+        uint32_t mask=0;
+        for(uint64_t stage=0;stage<stages;++stage){uint64_t ns=0,vk=0;XrBaselineStage item;
+            if(!xr_selection_number(input,ns)||ns>=8||!xr_selection_number(input,vk)||(vk!=1&&vk!=16)||(mask&vk)||
+               !xr_selection_number(input,item.fingerprint,true)||!xr_selection_number(input,item.words)||item.words<5||item.words>2*1024*1024)return false;
+            item.nvn_stage=uint32_t(ns);item.vk_stage=uint32_t(vk);mask|=uint32_t(vk);program.stages.push_back(item);
+        }
+        if(mask!=17)return false;next.programs.push_back(std::move(program));
+    }
+    std::string extra;if(input>>extra)return false;out=std::move(next);return true;
+}
+}
diff --git a/gpu/vk/xr_camera_block_capture.h b/gpu/vk/xr_camera_block_capture.h
new file mode 100644
index 0000000000000000000000000000000000000000..0442957b1c162ab86135c431a55e96c3f8360f5e
--- /dev/null
+++ b/gpu/vk/xr_camera_block_capture.h
@@ -0,0 +1,26 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <array>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+namespace mkwvk {
+struct CameraBlockSample {uint64_t frame=0,revision=0;uint32_t width=0,height=0;std::array<float,0x230/4> values{};};
+// Private diagnostic samples only. Production caller supplies an accepted submit-time camera match.
+class CameraBlockCapture {
+    std::array<CameraBlockSample,8> samples_{};size_t count_=0;
+public:
+    bool consider(uint64_t frame,uint64_t revision,uint32_t width,uint32_t height,const float* block,size_t count,CameraBlockSample& out) {
+        if(!revision||!width||!height||!block||count<0x230/4||count_==samples_.size())return false;
+        for(size_t i=0;i<0x230/4;++i)if(!std::isfinite(block[i]))return false;
+        for(size_t i=0;i<count_;++i) {
+            bool same=true;
+            for(int k=0;k<12;++k)if(std::abs(double(block[k])-samples_[i].values[k])>(k%4==3?0.001:0.00001))same=false;
+            if(same)return false;
+        }
+        CameraBlockSample sample{};sample.frame=frame;sample.revision=revision;sample.width=width;sample.height=height;
+        for(size_t i=0;i<sample.values.size();++i)sample.values[i]=block[i];
+        samples_[count_++]=sample;out=sample;return true;
+    }
+};
+}
diff --git a/gpu/vk/xr_camera_capture.h b/gpu/vk/xr_camera_capture.h
new file mode 100644
index 0000000000000000000000000000000000000000..648f7d845e99dfa934949378747c45d3f781a420
--- /dev/null
+++ b/gpu/vk/xr_camera_capture.h
@@ -0,0 +1,68 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include "vk_api.h"
+#include <cmath>
+#include <cstdint>
+namespace mkwvk {
+inline bool camera_view_valid(const float* rows) {
+    for(int i=0;i<12;++i)if(!std::isfinite(rows[i]))return false;
+    for(int r=0;r<3;++r)for(int s=0;s<3;++s) {
+        double dot=0;for(int c=0;c<3;++c)dot+=double(rows[4*r+c])*rows[4*s+c];
+        if(std::abs(dot-(r==s?1:0))>0.002)return false;
+    }
+    const double det=rows[0]*(double(rows[5])*rows[10]-double(rows[6])*rows[9])-
+        rows[1]*(double(rows[4])*rows[10]-double(rows[6])*rows[8])+rows[2]*(double(rows[4])*rows[9]-double(rows[5])*rows[8]);
+    return std::abs(det-1)<0.003;
+}
+inline bool camera_matrix_matches(const float* a,const float* b) {
+    for(int i=0;i<12;++i)if(std::abs(double(a[i])-b[i])>(i%4==3?0.01:0.0001))return false;
+    return true;
+}
+inline bool camera_projection_shape(const float* p) {
+    for(int i=0;i<16;++i)if(!std::isfinite(p[i]))return false;
+    const int zero[]={1,3,4,7,8,9,12,13,15};
+    for(int i:zero)if(std::abs(p[i])>0.000001f)return false;
+    return p[0]>0&&std::abs(p[5])>0.000001f&&std::abs(p[14]+1)<0.000001f;
+}
+struct CameraCapturePair {
+    MkwVkCameraObservation primary{},uniforms{};
+    uint64_t revision=0;
+};
+struct CameraCaptureStats { uint64_t primary=0,uniforms=0,matches=0,rejected=0; };
+// Single-owner state; caller supplies synchronization and a monotonic receiving clock.
+class CameraCapture {
+    MkwVkCameraObservation primary_{};
+    int64_t primary_at_=0,pair_at_=0;
+    CameraCapturePair pair_{};
+    CameraCaptureStats stats_{};
+    uint64_t last_sequence_=0;
+public:
+    bool observe(const MkwVkCameraObservation& sample,int64_t received_ns) {
+        // A new primary observation invalidates an old association even if the new view is unusable/debug.
+        if(sample.flags&MKWVK_CAMERA_PRIMARY) {primary_={};primary_at_=0;pair_={};pair_at_=0;}
+        if(sample.size!=sizeof sample||!sample.camera_id||!sample.sequence||sample.game_present<0||received_ns<=0||sample.sequence<=last_sequence_||
+           !camera_view_valid(sample.view)|| (sample.flags!=MKWVK_CAMERA_PRIMARY&&sample.flags!=MKWVK_CAMERA_UNIFORM)) {
+            ++stats_.rejected;return false;
+        }
+        last_sequence_=sample.sequence;
+        if(sample.flags==MKWVK_CAMERA_PRIMARY) {
+            for(double value:sample.eye)if(!std::isfinite(value)){++stats_.rejected;return false;}
+            primary_=sample;primary_at_=received_ns;++stats_.primary;
+            pair_={};pair_at_=0;return true;
+        }
+        if(!camera_projection_shape(sample.projection)){++stats_.rejected;return false;}
+        ++stats_.uniforms;
+        if(!primary_at_||received_ns<primary_at_||received_ns-primary_at_>100000000||
+           sample.game_present!=primary_.game_present||!camera_matrix_matches(sample.view,primary_.view))return true;
+        const auto revision=++stats_.matches;
+        pair_={primary_,sample,revision};pair_at_=received_ns;return true;
+    }
+    bool latest(int64_t now_ns,CameraCapturePair& out) const {
+        if(!pair_at_||now_ns<pair_at_||now_ns-pair_at_>100000000){out={};return false;}
+        out=pair_;return true;
+    }
+    CameraCaptureStats stats() const {return stats_;}
+};
+void xr_camera_observation(const MkwVkCameraObservation* sample);
+bool xr_camera_latest(CameraCapturePair* out);
+}
