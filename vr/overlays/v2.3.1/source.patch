+    constexpr uint64_t a=0x1000000000ull,b=0x7f00000000ull;EyePageStamp stamp{1,2,3,4};
+    check(eye_guest_page_index(a)==0&&eye_guest_page_index(b)==(8ull<<30>>12),"both backend windows");
