+void check(bool ok,const char* why){if(!ok)throw std::runtime_error(why);}
+namespace mkwvk {
+struct Pool {
+    enum {MIRROR_NONE,MIRROR_WANTED,MIRROR_ON};
+    VkBuffer buffer=VK_NULL_HANDLE,mirror=VK_NULL_HANDLE;uintptr_t mirror_alloc=0;
