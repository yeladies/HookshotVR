+        for(uint64_t i=100;i<109;++i)check(!xr_shader_uniform_audit_module(i,ignored.data(),ignored.size()),"unrequested graphics cannot consume compute quota");
+        check(xr_shader_uniform_audit_module(1,compute,10),"compute still exports after rejected graphics exceed byte quota");
+        uint64_t digest=0;size_t n=0;check(xr_shader_uniform_audit_identity(1,digest,n)&&n==10,"compute identity refers to actual exported data");
+        check(!xr_shader_uniform_audit_module(1,words,10)&&!xr_shader_uniform_audit_identity(1,digest,n),"ignored replacement clears reused handle identity");
