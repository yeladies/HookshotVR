+        p.color.retire(0);p.depth.retire(0);report(p,"allocation_or_shape_rejected");return;
+    }
+    auto views=[&](EyeImageClonePair& pair,const Texture& source,const EyeProbeView& active,EyeImageViewPair& out){
+        VkImageViewCreateInfo ci{VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO};ci.image=source.image;ci.viewType=VK_IMAGE_VIEW_TYPE_2D;
+        ci.format=active.format;ci.subresourceRange={source.aspect,active.level,1,active.layer,1};return pair.create_view_pair(ci,out);
+    };
