diff --git a/vr/src/same_state_gpu_copy.h b/vr/src/same_state_gpu_copy.h
new file mode 100644
index 0000000000000000000000000000000000000000..5bb2ad9647bc45b1f562478fd127b7fb74e8016f
--- /dev/null
+++ b/vr/src/same_state_gpu_copy.h
@@ -0,0 +1,56 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <vulkan/vulkan.h>
+#include <array>
+#include <cstdint>
+namespace hookshot::vr {
+// Internal, single-queue recording contract. The caller owns all images and must
+// prove nonaliasing, usage/format features and lifetime through queue completion.
+// Identity is producer provenance, not proof that a scene was rendered correctly.
+struct SameStateEyeImage {
+    VkImage image=VK_NULL_HANDLE;
+    uint64_t state=0,origin=0,pose_sample=0,recording=0;
+    uint32_t eye=0,width=0,height=0,queue_family=0;
+    VkFormat format=VK_FORMAT_UNDEFINED;
+};
+struct SameStateCopyTarget {
+    VkImage image=VK_NULL_HANDLE;
+    uint32_t width=0,height=0,queue_family=0;
+    VkFormat format=VK_FORMAT_UNDEFINED;
+    bool acquired_and_waited=false,nonaliasing_proven=false;
+};
+inline bool record_same_state_eye_copy(VkCommandBuffer command,uint64_t recording,
+        const std::array<SameStateEyeImage,2>& eyes,const SameStateCopyTarget& target,
+        PFN_vkCmdPipelineBarrier barrier,PFN_vkCmdCopyImage copy) {
+    const auto& a=eyes[0];const auto& b=eyes[1];
+    if(!command||!recording||!barrier||!copy||!target.image||!target.acquired_and_waited||!target.nonaliasing_proven||
+       !a.image||!b.image||a.image==b.image||a.image==target.image||b.image==target.image||
+       !a.state||!a.origin||!a.pose_sample||a.state!=b.state||a.origin!=b.origin||a.pose_sample!=b.pose_sample||
+       a.recording!=recording||b.recording!=recording||a.eye!=0||b.eye!=1||
+       !a.width||!a.height||a.width>8192||a.height>8192||a.width!=b.width||a.height!=b.height||
+       target.width!=2*a.width||target.height!=a.height||a.queue_family!=b.queue_family||a.queue_family!=target.queue_family||
+       a.format!=b.format||a.format!=target.format||
+       (a.format!=VK_FORMAT_R8G8B8A8_UNORM&&a.format!=VK_FORMAT_R8G8B8A8_SRGB))return false;
+    // Sources must already be GENERAL on this same queue. No queue ownership
+    // transfer or guessed layouts; source images remain GENERAL after copying.
+    std::array<VkImageMemoryBarrier,3> images{};
+    for(unsigned i=0;i<3;++i){auto& v=images[i];v.sType=VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER;
+        v.srcQueueFamilyIndex=v.dstQueueFamilyIndex=VK_QUEUE_FAMILY_IGNORED;
+        v.subresourceRange={VK_IMAGE_ASPECT_COLOR_BIT,0,1,0,1};
+        v.image=i<2?eyes[i].image:target.image;
+        v.oldLayout=i<2?VK_IMAGE_LAYOUT_GENERAL:VK_IMAGE_LAYOUT_UNDEFINED;
+        v.newLayout=i<2?VK_IMAGE_LAYOUT_GENERAL:VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+        v.srcAccessMask=i<2?VK_ACCESS_MEMORY_WRITE_BIT:0;
+        v.dstAccessMask=i<2?VK_ACCESS_TRANSFER_READ_BIT:VK_ACCESS_TRANSFER_WRITE_BIT;
+    }
+    barrier(command,VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,VK_PIPELINE_STAGE_TRANSFER_BIT,0,0,nullptr,0,nullptr,3,images.data());
+    for(unsigned i=0;i<2;++i){VkImageCopy region{};region.srcSubresource=region.dstSubresource={VK_IMAGE_ASPECT_COLOR_BIT,0,0,1};
+        region.extent={a.width,a.height,1};region.dstOffset.x=int32_t(i*a.width);
+        copy(command,eyes[i].image,VK_IMAGE_LAYOUT_GENERAL,target.image,VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,1,&region);
+    }
+    VkImageMemoryBarrier done=images[2];done.oldLayout=VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;done.newLayout=VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+    done.srcAccessMask=VK_ACCESS_TRANSFER_WRITE_BIT;done.dstAccessMask=VK_ACCESS_COLOR_ATTACHMENT_READ_BIT|VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+    barrier(command,VK_PIPELINE_STAGE_TRANSFER_BIT,VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT,0,0,nullptr,0,nullptr,1,&done);
+    return true;
+}
+}
diff --git a/vr/src/scene_math.h b/vr/src/scene_math.h
new file mode 100644
index 0000000000000000000000000000000000000000..779575ef5638754f78d4ee1ba2a1cc762eb26967
--- /dev/null
+++ b/vr/src/scene_math.h
@@ -0,0 +1,45 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <openxr/openxr.h>
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+
+namespace hookshot::vr {
+struct MarkerRect { int32_t x, y; uint32_t width, height; float distance; };
+// Project world-space billboards into one eye. XR looks down -Z, framebuffer Y points down.
+inline bool marker_rect(const XrPosef& eye, const XrFovf& fov, XrVector3f world, float radius,
+                        uint32_t width, uint32_t height, MarkerRect& out) {
+    const auto q = eye.orientation;
+    const float norm = q.x*q.x + q.y*q.y + q.z*q.z + q.w*q.w;
+    if (!width || !height || !std::isfinite(norm) || std::abs(norm - 1.0f) > 0.01f ||
+        !std::isfinite(radius) || radius <= 0) return false;
+    const XrVector3f v{world.x-eye.position.x, world.y-eye.position.y, world.z-eye.position.z};
+    // q^-1 * v * q, expanded without a matrix convention dependency.
+    const XrVector3f t{2*(-q.y*v.z+q.z*v.y), 2*(-q.z*v.x+q.x*v.z), 2*(-q.x*v.y+q.y*v.x)};
+    const XrVector3f p{v.x+q.w*t.x-q.y*t.z+q.z*t.y,
+                      v.y+q.w*t.y-q.z*t.x+q.x*t.z,
+                      v.z+q.w*t.z-q.x*t.y+q.y*t.x};
+    const float d = -p.z;
+    const float left=std::tan(fov.angleLeft), right=std::tan(fov.angleRight);
+    const float down=std::tan(fov.angleDown), up=std::tan(fov.angleUp);
+    if (!std::isfinite(d) || !std::isfinite(p.x) || !std::isfinite(p.y) || d <= 0.08f ||
+        !std::isfinite(left) || !std::isfinite(right) || !std::isfinite(down) || !std::isfinite(up) ||
+        right <= left || up <= down) return false;
+    const float x = (p.x/d-left)/(right-left), y=(up-p.y/d)/(up-down);
+    const float rx=radius/d/(right-left), ry=radius/d/(up-down);
+    const float x0=std::clamp(x-rx, 0.f, 1.f), x1=std::clamp(x+rx, 0.f, 1.f);
+    const float y0=std::clamp(y-ry, 0.f, 1.f), y1=std::clamp(y+ry, 0.f, 1.f);
+    if (x1 <= x0 || y1 <= y0) return false;
+    const auto ix0=static_cast<uint32_t>(x0*width), iy0=static_cast<uint32_t>(y0*height);
+    const auto ix1=std::min(width, static_cast<uint32_t>(std::ceil(x1*width)));
+    const auto iy1=std::min(height, static_cast<uint32_t>(std::ceil(y1*height)));
+    if (ix1 <= ix0 || iy1 <= iy0) return false;
+    out={static_cast<int32_t>(ix0),static_cast<int32_t>(iy0),ix1-ix0,iy1-iy0,d};
+    return true;
+}
+inline bool pose_valid(XrSpaceLocationFlags flags) {
+    constexpr XrSpaceLocationFlags need=XR_SPACE_LOCATION_POSITION_VALID_BIT|XR_SPACE_LOCATION_ORIENTATION_VALID_BIT;
+    return (flags&need)==need;
+}
+} // namespace hookshot::vr
diff --git a/vr/src/session_main.cpp b/vr/src/session_main.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..59525e829ccdbc46814da9c0408bc642cb3f5da1
--- /dev/null
+++ b/vr/src/session_main.cpp
@@ -0,0 +1,464 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Minimal stereo marker scene: no game, shaders, assets or simulated physics.
+#define VK_NO_PROTOTYPES
+#define XR_USE_GRAPHICS_API_VULKAN
+#include <vulkan/vulkan.h>
+#include <openxr/openxr.h>
+#include <openxr/openxr_platform.h>
+#include "scene_math.h"
+#include "depth_scene_renderer.h"
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <cstring>
+#include <iostream>
+#include <stdexcept>
+#include <string>
+#include <thread>
+#include <vector>
+#ifdef _WIN32
+#define WIN32_LEAN_AND_MEAN
+#define NOMINMAX
+#include <windows.h>
+#else
+#include <dlfcn.h>
+#endif
+
+namespace {
+using Clock=std::chrono::steady_clock;
+void xr_check(XrResult r,const char* name) {
+    if(XR_FAILED(r)) throw std::runtime_error(std::string(name)+": XrResult "+std::to_string(r));
+}
+void vk_check(VkResult r,const char* name) {
+    if(r!=VK_SUCCESS) throw std::runtime_error(std::string(name)+": VkResult "+std::to_string(r));
+}
+template<class T> T xr_function(XrInstance instance,const char* name) {
+    PFN_xrVoidFunction p=nullptr;
+    xr_check(xrGetInstanceProcAddr(instance,name,&p),name);
+    return reinterpret_cast<T>(p);
+}
+#define DEVICE_FUNCTIONS(X) \
+ X(DestroyDevice) X(GetDeviceQueue) X(CreateCommandPool) X(DestroyCommandPool) X(AllocateCommandBuffers) \
+ X(ResetCommandBuffer) X(BeginCommandBuffer) X(EndCommandBuffer) X(CreateFence) X(DestroyFence) \
+ X(ResetFences) X(WaitForFences) X(QueueSubmit) X(DeviceWaitIdle) X(CreateRenderPass) X(DestroyRenderPass) \
+ X(CreateImageView) X(DestroyImageView) X(CreateFramebuffer) X(DestroyFramebuffer) \
+ X(CmdBeginRenderPass) X(CmdEndRenderPass) X(CmdClearAttachments)
+struct Vulkan {
+    VkInstance instance=VK_NULL_HANDLE;
+    VkPhysicalDevice physical=VK_NULL_HANDLE;
+    VkDevice device=VK_NULL_HANDLE;
+    VkQueue queue=VK_NULL_HANDLE;
+    uint32_t queue_family=0;
+    PFN_vkGetInstanceProcAddr get=nullptr;
+    PFN_vkGetDeviceProcAddr get_device=nullptr;
+    PFN_vkDestroyInstance destroy_instance=nullptr;
+#define DECL(name) PFN_vk##name name=nullptr;
+    DEVICE_FUNCTIONS(DECL)
+#undef DECL
+#ifdef _WIN32
+    HMODULE library=nullptr;
+#else
+    void* library=nullptr;
+#endif
+    void load() {
+#ifdef _WIN32
+        library=LoadLibraryExW(L"vulkan-1.dll",nullptr,LOAD_LIBRARY_SEARCH_SYSTEM32);
+        if(library) get=reinterpret_cast<PFN_vkGetInstanceProcAddr>(GetProcAddress(library,"vkGetInstanceProcAddr"));
+#else
+        library=dlopen("libvulkan.so.1",RTLD_NOW|RTLD_LOCAL);
+        if(library) get=reinterpret_cast<PFN_vkGetInstanceProcAddr>(dlsym(library,"vkGetInstanceProcAddr"));
+#endif
+        if(!get) throw std::runtime_error("System Vulkan loader unavailable");
+    }
+    template<class T> T function(const char* name) {
+        const auto p=get(instance,name);
+        if(!p) throw std::runtime_error(std::string("Missing Vulkan function: ")+name);
+        return reinterpret_cast<T>(p);
+    }
+    void device_functions() {
+        get_device=function<PFN_vkGetDeviceProcAddr>("vkGetDeviceProcAddr");
+#define LOAD(name) name=reinterpret_cast<PFN_vk##name>(get_device(device,"vk" #name)); if(!name) throw std::runtime_error("Missing vk" #name);
+        DEVICE_FUNCTIONS(LOAD)
+#undef LOAD
+    }
+    ~Vulkan() {
+        if(device && DestroyDevice) DestroyDevice(device,nullptr);
+        if(instance && destroy_instance) destroy_instance(instance,nullptr);
+#ifdef _WIN32
+        if(library) FreeLibrary(library);
+#else
+        if(library) dlclose(library);
+#endif
+    }
+};
+#include "depth_scene_smoke.h"
+struct Eye {
+    XrSwapchain swapchain=XR_NULL_HANDLE;
+    uint32_t width=0,height=0;
+    std::vector<XrSwapchainImageVulkan2KHR> images;
+    std::vector<VkImageView> views;
+    std::vector<VkFramebuffer> frames;
+};
+struct Marker { XrVector3f position; float radius; std::array<float,4> color; };
+struct Scene {
+    Vulkan vk;
+    hookshot::vr::DepthSceneRenderer depth_scene;XrPosef depth_anchor{};bool depth_anchored=false,depth_head_valid=false;XrTime depth_origin_change=0;
+    XrInstance instance=XR_NULL_HANDLE;
+    XrSystemId system=XR_NULL_SYSTEM_ID;
+    XrSession session=XR_NULL_HANDLE;
+    XrSpace local=XR_NULL_HANDLE, head=XR_NULL_HANDLE;
+    XrActionSet action_set=XR_NULL_HANDLE;
+    XrAction grip=XR_NULL_HANDLE;
+    std::array<XrPath,2> hands{};
+    std::array<XrSpace,2> hand_spaces{};
+    std::array<XrSpaceLocation,2> hand_locations{};
+    std::array<bool,2> hand_valid{};
+    std::array<Eye,2> eyes{};
