diff --git a/gpu/vk/xr_shifted_draw_check.h b/gpu/vk/xr_shifted_draw_check.h
new file mode 100644
index 0000000000000000000000000000000000000000..fb7ffdd6f128684199268f97a058bba4bb070734
--- /dev/null
+++ b/gpu/vk/xr_shifted_draw_check.h
@@ -0,0 +1,36 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <array>
+#include <cstdint>
+#include <cstddef>
+#include <cstring>
+#include <cmath>
+namespace mkwvk {
+struct XrShiftedDrawComparison {
+    bool verified=false;std::array<uint64_t,3> changed{};std::array<double,3> x{},y{};
+};
+// Six tightly packed 32-bit color or D32 snapshots: before, original after, two exact baselines, two shifted
+// draws. A mask-centroid check is a bounded raster diagnostic, not scene coverage.
+inline XrShiftedDrawComparison compare_xr_shifted_draw(const void* data,size_t available,uint32_t width,uint32_t height,bool translated=false){
+    XrShiftedDrawComparison out;
+    if(!data||width<160||height<1||width>4096||height>4096)return out;
+    const uint64_t pixels=uint64_t(width)*height,frame=pixels*4;
+    if(available!=6*frame)return out;
+    const auto* bytes=static_cast<const unsigned char*>(data);
+    if(std::memcmp(bytes+frame,bytes+2*frame,size_t(frame))||std::memcmp(bytes+frame,bytes+3*frame,size_t(frame)))return out;
+    for(unsigned i=0;i<3;++i){const auto* image=bytes+(i?i+3:1)*frame;
+        for(uint64_t p=0;p<pixels;++p)if(std::memcmp(bytes+p*4,image+p*4,4)){++out.changed[i];out.x[i]+=double(p%width);out.y[i]+=double(p/width);}
+        if(out.changed[i]){out.x[i]/=out.changed[i];out.y[i]/=out.changed[i];}
+    }
+    for(auto count:out.changed)if(count<16)return out;
+    for(unsigned i=1;i<3;++i){
+        const double ratio=double(out.changed[i])/out.changed[0];
+        if(ratio<.75||ratio>1.25||std::abs(out.y[i]-out.y[0])>1.25)return out;
+        const double dx=out.x[i]-out.x[0];
+        if(translated){if((i==1?-dx:dx)<.25||std::abs(dx)>width*.2)return out;}
+        else if(std::abs(dx-(i==1?-4:4))>1.25)return out;
+    }
+    if(translated&&std::abs(out.x[1]+out.x[2]-2*out.x[0])>2)return out;
+    out.verified=std::memcmp(bytes+4*frame,bytes+5*frame,size_t(frame))!=0;return out;
+}
+}
diff --git a/gpu/vk/xr_synthetic_head.h b/gpu/vk/xr_synthetic_head.h
new file mode 100644
index 0000000000000000000000000000000000000000..1a1796d4d7f4e41c9e35173747234841f3009927
--- /dev/null
+++ b/gpu/vk/xr_synthetic_head.h
@@ -0,0 +1,19 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include "xr_immersive_camera.h"
+namespace mkwvk {
+// Diagnostic only: the caller rejects this path whenever an XR session is active.
+// Begin centred so reference anchoring cannot cancel the requested test angle.
+inline double synthetic_head_angle(const char* mode,double elapsed){
+    if(!std::isfinite(elapsed)||elapsed<0)return 0;
+    if(mode&&(!std::strcmp(mode,"WideYaw")||!std::strcmp(mode,"WidePitch")))
+        return elapsed<=3?0:.7853981633974483*std::sin((elapsed-3)*.3141592653589793);
+    return .12*std::sin(elapsed*.7);
+}
+inline void synthetic_head_pose(const char* mode,double elapsed,ImmersivePose& pose){
+    const double angle=synthetic_head_angle(mode,elapsed);
+    const unsigned axis=mode&&!std::strcmp(mode,"WidePitch")?0:1;
+    pose.q[0]=pose.q[1]=pose.q[2]=0;pose.q[axis]=float(std::sin(angle/2));pose.q[3]=float(std::cos(angle/2));
+    pose.p[0]=axis==1&&(!mode||!std::strcmp(mode,"Small"))?float(.04*std::sin(elapsed)):0;
+}
+}
diff --git a/gpu/vk/xr_uniform_camera_scan.h b/gpu/vk/xr_uniform_camera_scan.h
new file mode 100644
index 0000000000000000000000000000000000000000..1b19cd72a7df6dd3cecd6820faba647cd118f31c
--- /dev/null
+++ b/gpu/vk/xr_uniform_camera_scan.h
@@ -0,0 +1,57 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include "xr_camera_submission.h"
+#include <algorithm>
+#include <vector>
+namespace mkwvk {
+struct UniformCameraScan {
+    bool eligible=false,truncated=false;
+    uint32_t ambiguous_offsets=0;
+    std::vector<uint32_t> view_offsets,projection_offsets,vp_offsets;
+};
+// Read-only candidate search at 16-byte-aligned offsets in one bounded copied UBO.
+// Coincident values, especially projection alone, do not prove field semantics.
+inline UniformCameraScan scan_submitted_uniform(const SceneSubmissionSnapshot* snapshot,int64_t now,
+                                                const float* data,size_t count) {
+    UniformCameraScan out;
+    if(!snapshot||!data||count>65536/4||count<12||snapshot->captured_ns<=0||now<snapshot->captured_ns||
+       now-snapshot->captured_ns>500000000)return out;
+    struct Camera {uint64_t id;const float* view;const float* projection;float vp[16]{};};
+    std::vector<Camera> cameras;
+    for(size_t i=0;i<snapshot->count&&i<snapshot->cameras.size();++i){
+        const auto& c=snapshot->cameras[i];const auto& p=c.pair;
+        if(!p.revision||!p.primary.camera_id||c.received_ns<=0||c.received_ns>snapshot->captured_ns||
+           snapshot->captured_ns-c.received_ns>250000000||!camera_view_valid(p.primary.view)||
+           !camera_projection_shape(p.uniforms.projection))continue;
+        Camera camera{p.primary.camera_id,p.primary.view,p.uniforms.projection,{}};
+        for(int r=0;r<4;++r)for(int col=0;col<4;++col){double v=0;for(int k=0;k<4;++k)
+            v+=double(camera.projection[4*r+k])*(k==3?(col==3?1:0):camera.view[4*k+col]);camera.vp[4*r+col]=float(v);}
+        bool finite=true;for(float value:camera.vp)finite=finite&&std::isfinite(value);
+        if(finite)cameras.push_back(camera);
+    }
+    if(cameras.empty())return out;out.eligible=true;
+    size_t hits=0;
+    for(size_t offset=0;offset+12<=count;offset+=4){
+        unsigned kinds=0;uint64_t identity=0;bool ambiguous=false;
+        for(const auto& camera:cameras){
+            bool view=true,projection=offset+16<=count,vp=projection;
+            for(int i=0;i<12;++i)if(!std::isfinite(data[offset+i])||
+                std::abs(double(data[offset+i])-camera.view[i])>(i%4==3?.01:.0001))view=false;
+            if(offset+16<=count)for(int i=0;i<16;++i){
+                const double value=data[offset+i];
+                if(!std::isfinite(value)||std::abs(value-camera.projection[i])>((i==2||i==6)?.01:.0001))projection=false;
+                if(!std::isfinite(value)||std::abs(value-camera.vp[i])>.02+std::abs(double(camera.vp[i]))*.0001)vp=false;
+            }
+            unsigned matched=(view?1u:0u)|(projection?2u:0u)|(vp?4u:0u);
+            if(matched){if(identity&&identity!=camera.id)ambiguous=true;identity=camera.id;kinds|=matched;}
+        }
+        if(!kinds)continue;
+        if(ambiguous){++out.ambiguous_offsets;continue;}
+        if(hits++>=64){out.truncated=true;break;}
+        if(kinds&1)out.view_offsets.push_back(uint32_t(offset*4));
+        if(kinds&2)out.projection_offsets.push_back(uint32_t(offset*4));
+        if(kinds&4)out.vp_offsets.push_back(uint32_t(offset*4));
+    }
+    return out;
+}
+}
diff --git a/gpu/vk/xr_uniform_copy_source.h b/gpu/vk/xr_uniform_copy_source.h
new file mode 100644
index 0000000000000000000000000000000000000000..57f4b13a7bbb1a79093ec8d5e58f13740745cbd9
--- /dev/null
+++ b/gpu/vk/xr_uniform_copy_source.h
@@ -0,0 +1,27 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <vulkan/vulkan.h>
+#include <cstdint>
+namespace mkwvk {
+enum class XrUniformSourceKind {Unsupported,Mirror,SparseMirror};
+struct XrUniformSourceStamp {uint64_t recording=0,pool_generation=0,capture_generation=0;};
+struct XrGuestRootSource {uint64_t address=0,bytes=0;XrUniformSourceStamp stamp{};};
+struct XrUniformCopySource {
+    VkBuffer buffer=VK_NULL_HANDLE;uint64_t bytes=0;VkBufferUsageFlags usage=0;
+    XrUniformSourceKind kind=XrUniformSourceKind::Unsupported;XrUniformSourceStamp stamp{};
+    // The verified resident interval may be smaller than the logical sparse buffer.
+    uint64_t resident_offset=0,resident_bytes=0;
+    uint64_t guest_address=0; // CPU guest address of the requested range, proven by the current imported pool.
+};
+inline bool xr_uniform_copy_source_valid(const XrUniformCopySource& source,VkBuffer expected,uint64_t offset,uint64_t bytes,
+                                         const XrUniformSourceStamp& current){
+    const auto needed=VK_BUFFER_USAGE_TRANSFER_SRC_BIT|VK_BUFFER_USAGE_UNIFORM_BUFFER_BIT;
+    return expected&&source.buffer==expected&&(source.kind==XrUniformSourceKind::Mirror||source.kind==XrUniformSourceKind::SparseMirror)&&(source.usage&needed)==needed&&
+        source.stamp.recording&&source.stamp.pool_generation&&source.stamp.capture_generation&&
+        source.stamp.recording==current.recording&&source.stamp.pool_generation==current.pool_generation&&source.stamp.capture_generation==current.capture_generation&&
+        bytes&&bytes<=65536&&!(offset%4)&&!(bytes%4)&&offset<=source.bytes&&bytes<=source.bytes-offset&&
+        source.resident_offset<=source.bytes&&source.resident_bytes<=source.bytes-source.resident_offset&&
+        offset>=source.resident_offset&&offset-source.resident_offset<=source.resident_bytes&&
+        bytes<=source.resident_bytes-(offset-source.resident_offset);
+}
+}
diff --git a/host/hos_main.c b/host/hos_main.c
index 503f3fe7f2f544558ecc8518b47d45618dcb9cc0..976262e5209ceaa06ea1a1a925b1cb50bf2a6c6d 100644
